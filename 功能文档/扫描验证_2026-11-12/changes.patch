diff --git a/Scripts/ReplicatedStorage/Scripts/Shared/FarmEconomyConfig.luau b/Scripts/ReplicatedStorage/Scripts/Shared/FarmEconomyConfig.luau
new file mode 100644
index 0000000..4ea0c6c
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Shared/FarmEconomyConfig.luau
@@ -0,0 +1,348 @@
+-- 新版个人农场数值契约：从配表 Data 组装五物种、四品质、五阶装备与餐厅参数
+--!strict
+export type SpeciesId = "chicken" | "rabbit" | "sheep" | "cow" | "dragon"
+export type QualityId = "normal" | "golden" | "rainbow" | "giant"
+export type Species = {
+	id: number,
+	key: SpeciesId,
+	speciesId: SpeciesId,
+	tier: number,
+	name: string,
+	foodName: string,
+	name_t: string,
+	foodName_t: string,
+	description_t: string?,
+	health: number,
+	interval: number,
+	hatchSeconds: number,
+	weightKg: number,
+	saleValue: number,
+	unlockPrice: number,
+	packSeconds: number,
+	instantHatchPrice: number,
+}
+export type Quality = {
+	id: number,
+	key: QualityId,
+	qualityId: QualityId,
+	tier: number,
+	name_t: string?,
+	description_t: string?,
+	colorHex: string?,
+	probability: number,
+	healthMultiplier: number,
+	weightMultiplier: number,
+	valueMultiplier: number,
+	hatchMultiplier: number,
+	packMultiplier: number,
+	visualScale: number,
+}
+export type Weapon = {
+	id: number?, tier: number?, name_t: string?, description_t: string?,
+	range: number, mode: "single" | "chain" | "cone", maximumTargets: number,
+	angleDegrees: number, chainRange: number, damage: number, damageIncrement: number,
+	price: number, enhancementPrices: { number },
+}
+export type Collector = {
+	id: number?, tier: number?, name_t: string?, description_t: string?,
+	range: number, maximumItems: number, angleDegrees: number, price: number,
+}
+export type Basket = {
+	id: number?, tier: number?, name_t: string?, description_t: string?,
+	capacityKg: number, price: number,
+}
+export type Restaurant = {
+	id: number?, level: number?, name_t: string?, description_t: string?,
+	workers: number, speed: number, price: number,
+}
+type DataRow = { [string]: any }
+
+local Config = {
+	Version = 1, -- 货物生成时保存的数值版本；后续更新不重算已有货物售价/重量
+	PopulationCapacity = 28, -- 每名玩家蛋和活体合计上限，单位个
+	EggFlightSeconds = 1.15, -- 飞行结束后开始孵化，秒
+	GroundLifetimeSeconds = 75, -- 地面货物过期，入筐后取消，秒
+	ZapCooldownSeconds = 0.35, -- 服务端电击冷却，秒
+	CollectCooldownSeconds = 0.35, -- 服务端拾取冷却，秒
+	HatchCooldownSeconds = 0.75, -- 免费加速冷却，秒
+	HatchReductionSeconds = 1, -- 每次免费减少秒数，最低为零
+	HatchInteractionRange = 8, -- 自家落地蛋的交互距离，studs
+	UnloadIntervalSeconds = 0.15, -- 首次入区也等待完整间隔，秒/份
+	AnimalWalkSpeed = 4, -- studs/秒
+	AnimalFleeSpeed = 9, -- studs/秒
+	AnimalFleeRange = 8, -- studs
+	AnimalFleeSeconds = 1.2, -- 受惊持续秒数
+	MaximumWeaponLevel = 5, -- 每件武器独立从 Lv.1 强化至 Lv.5
+}
+
+-- Studio 读 GameConfig 子模块；离线 Lune 按源码相对路径加载同一份 Data。
+local function LoadRows(moduleName: string): { DataRow }
+	local loaded: any
+	if script then
+		local gameConfig = script.Parent:WaitForChild("GameConfig")
+		if moduleName == "SpeciesData" then
+			loaded = require(gameConfig:WaitForChild("SpeciesData"))
+		elseif moduleName == "QualityData" then
+			loaded = require(gameConfig:WaitForChild("QualityData"))
+		elseif moduleName == "WeaponData" then
+			loaded = require(gameConfig:WaitForChild("WeaponData"))
+		elseif moduleName == "CollectorData" then
+			loaded = require(gameConfig:WaitForChild("CollectorData"))
+		elseif moduleName == "BasketData" then
+			loaded = require(gameConfig:WaitForChild("BasketData"))
+		elseif moduleName == "RestaurantData" then
+			loaded = require(gameConfig:WaitForChild("RestaurantData"))
+		elseif moduleName == "SpeciesAppearanceData" then
+			loaded = require(gameConfig:WaitForChild("SpeciesAppearanceData"))
+		else
+			error("Unknown farm data module")
+		end
+	elseif moduleName == "SpeciesData" then
+		loaded = require("./GameConfig/SpeciesData")
+	elseif moduleName == "QualityData" then
+		loaded = require("./GameConfig/QualityData")
+	elseif moduleName == "WeaponData" then
+		loaded = require("./GameConfig/WeaponData")
+	elseif moduleName == "CollectorData" then
+		loaded = require("./GameConfig/CollectorData")
+	elseif moduleName == "BasketData" then
+		loaded = require("./GameConfig/BasketData")
+	elseif moduleName == "RestaurantData" then
+		loaded = require("./GameConfig/RestaurantData")
+	elseif moduleName == "SpeciesAppearanceData" then
+		loaded = require("./GameConfig/SpeciesAppearanceData")
+	else
+		error("Unknown farm data module")
+	end
+	assert(type(loaded) == "table", moduleName)
+	return loaded :: { DataRow }
+end
+local function NumberField(row: DataRow, field: string): number
+	local value = row[field]
+	assert(type(value) == "number", field)
+	return value :: number
+end
+local function StringField(row: DataRow, field: string): string
+	local value = row[field]
+	assert(type(value) == "string", field)
+	return value :: string
+end
+local function NumberList(row: DataRow, field: string): { number }
+	local value = row[field]
+	assert(type(value) == "table", field)
+	local source = value :: { any }
+	local result: { number } = {}
+	for index, item in source do
+		assert(type(item) == "number", field)
+		result[index] = item :: number
+	end
+	return result
+end
+local function SpeciesIdOf(value: string): SpeciesId
+	assert(value == "chicken" or value == "rabbit" or value == "sheep" or value == "cow" or value == "dragon", value)
+	return value :: SpeciesId
+end
+local function QualityIdOf(value: string): QualityId
+	assert(value == "normal" or value == "golden" or value == "rainbow" or value == "giant", value)
+	return value :: QualityId
+end
+local function WeaponMode(value: string): "single" | "chain" | "cone"
+	assert(value == "single" or value == "chain" or value == "cone", value)
+	return value :: "single" | "chain" | "cone"
+end
+
+-- 物种字段单位依次为 HP、秒、秒、kg、金币、金币、秒、金币；行顺序即阶位。
+local speciesList: { Species } = {}
+for index, row in LoadRows("SpeciesData") do
+	local tier = NumberField(row, "tier")
+	assert(tier == index, "Species tier must match row order")
+	local idNum = if row.id ~= nil then NumberField(row, "id") else index
+	local keyVal = SpeciesIdOf(StringField(row, "key"))
+	local nameVal = if row.name_t ~= nil then StringField(row, "name_t") else StringField(row, "name")
+	local foodNameVal = if row.foodName_t ~= nil then StringField(row, "foodName_t") else StringField(row, "foodName")
+	table.insert(speciesList, {
+		id = idNum,
+		key = keyVal,
+		speciesId = keyVal,
+		tier = tier,
+		name = nameVal,
+		foodName = foodNameVal,
+		name_t = nameVal,
+		foodName_t = foodNameVal,
+		description_t = if row.description_t ~= nil then StringField(row, "description_t") else nil,
+		health = NumberField(row, "health"),
+		interval = NumberField(row, "interval"),
+		hatchSeconds = NumberField(row, "hatchSeconds"),
+		weightKg = NumberField(row, "weightKg"),
+		saleValue = NumberField(row, "saleValue"),
+		unlockPrice = NumberField(row, "unlockPrice"),
+		packSeconds = NumberField(row, "packSeconds"),
+		instantHatchPrice = NumberField(row, "instantHatchPrice"),
+	})
+end
+assert(#speciesList == 5, "Five species tiers are required")
+Config.Species = speciesList
+-- 普通外观覆色；优先读取 GameConfig.SpeciesAppearance，若未配置则回退到配表
+local appearance: { [string]: { [string]: string } } = {}
+local hasGameConfigAppearance = false
+if script and script.Parent then
+	local gameConfigMod = script.Parent:FindFirstChild("GameConfig")
+	if gameConfigMod and gameConfigMod:IsA("ModuleScript") then
+		local ok, gc = pcall(require, gameConfigMod)
+		if ok and type(gc) == "table" and gc.SpeciesAppearance then
+			appearance = gc.SpeciesAppearance
+			hasGameConfigAppearance = true
+		end
+	end
+end
+
+if not hasGameConfigAppearance then
+	for _, row in LoadRows("SpeciesAppearanceData") do
+		local speciesId: string
+		if type(row.speciesId) == "number" then
+			if row.speciesId == 1 then
+				speciesId = "chicken"
+			elseif row.speciesId == 5 then
+				speciesId = "dragon"
+			else
+				speciesId = tostring(row.speciesId)
+			end
+		else
+			speciesId = StringField(row, "speciesId")
+		end
+		if appearance[speciesId] == nil then
+			appearance[speciesId] = {}
+		end
+		local parts = appearance[speciesId] :: { [string]: string }
+		parts[StringField(row, "partName")] = StringField(row, "color")
+	end
+end
+Config.SpeciesAppearance = appearance
+-- 概率和为 1；视觉缩放与重量倍率独立，巨型外观 2.5 倍、血量/重量 4 倍。
+local qualities: { Quality } = {}
+local probability = 0
+for index, row in LoadRows("QualityData") do
+	local idNum = if row.id ~= nil then NumberField(row, "id") else index
+	local keyVal = QualityIdOf(StringField(row, "key"))
+	local quality: Quality = {
+		id = idNum,
+		key = keyVal,
+		qualityId = keyVal,
+		tier = if row.tier ~= nil then NumberField(row, "tier") else index,
+		name_t = if row.name_t ~= nil then StringField(row, "name_t") else nil,
+		description_t = if row.description_t ~= nil then StringField(row, "description_t") else nil,
+		colorHex = if row.colorHex ~= nil then StringField(row, "colorHex") else nil,
+		probability = NumberField(row, "probability"),
+		healthMultiplier = NumberField(row, "healthMultiplier"),
+		weightMultiplier = NumberField(row, "weightMultiplier"),
+		valueMultiplier = NumberField(row, "valueMultiplier"),
+		hatchMultiplier = NumberField(row, "hatchMultiplier"),
+		packMultiplier = NumberField(row, "packMultiplier"),
+		visualScale = NumberField(row, "visualScale"),
+	}
+	probability += quality.probability
+	table.insert(qualities, quality)
+end
+assert(#qualities == 4 and math.abs(probability - 1) < 1e-9, "Quality probabilities must sum to 1")
+Config.Qualities = qualities
+-- 射程/跳距为 studs，角度为完整射界，伤害为每发共享总量，费用为金币。
+local weapons: { Weapon } = {}
+for index, row in LoadRows("WeaponData") do
+	local prices = NumberList(row, "enhancementPrices")
+	assert(#prices == Config.MaximumWeaponLevel - 1, "Each weapon lists four enhancement prices")
+	table.insert(weapons, {
+		id = if row.id ~= nil then NumberField(row, "id") else index,
+		tier = if row.tier ~= nil then NumberField(row, "tier") else index,
+		name_t = if row.name_t ~= nil then StringField(row, "name_t") else nil,
+		description_t = if row.description_t ~= nil then StringField(row, "description_t") else nil,
+		range = NumberField(row, "range"),
+		mode = WeaponMode(StringField(row, "mode")),
+		maximumTargets = NumberField(row, "maximumTargets"),
+		angleDegrees = NumberField(row, "angleDegrees"),
+		chainRange = NumberField(row, "chainRange"),
+		damage = NumberField(row, "damage"),
+		damageIncrement = NumberField(row, "damageIncrement"),
+		price = NumberField(row, "price"),
+		enhancementPrices = prices,
+	})
+end
+assert(#weapons == 5, "Five weapon tiers are required")
+Config.Weapons = weapons
+-- 拾取范围 studs，360 表示周围；成功拾取数才计入 maximumItems，费用为金币。
+local collectors: { Collector } = {}
+for index, row in LoadRows("CollectorData") do
+	table.insert(collectors, {
+		id = if row.id ~= nil then NumberField(row, "id") else index,
+		tier = if row.tier ~= nil then NumberField(row, "tier") else index,
+		name_t = if row.name_t ~= nil then StringField(row, "name_t") else nil,
+		description_t = if row.description_t ~= nil then StringField(row, "description_t") else nil,
+		range = NumberField(row, "range"),
+		maximumItems = NumberField(row, "maximumItems"),
+		angleDegrees = NumberField(row, "angleDegrees"),
+		price = NumberField(row, "price"),
+	})
+end
+assert(#collectors == 5, "Five collector tiers are required")
+Config.Collectors = collectors
+-- 鸡筐承重 kg，逐阶购买费为金币，独立于拾取工具。
+local baskets: { Basket } = {}
+for index, row in LoadRows("BasketData") do
+	table.insert(baskets, {
+		id = if row.id ~= nil then NumberField(row, "id") else index,
+		tier = if row.tier ~= nil then NumberField(row, "tier") else index,
+		name_t = if row.name_t ~= nil then StringField(row, "name_t") else nil,
+		description_t = if row.description_t ~= nil then StringField(row, "description_t") else nil,
+		capacityKg = NumberField(row, "capacityKg"),
+		price = NumberField(row, "price"),
+	})
+end
+assert(#baskets == 5, "Five basket tiers are required")
+Config.Baskets = baskets
+-- 接单时记录单人速度倍率；升级不追溯修改正在打包的订单，费用为金币。
+local restaurants: { Restaurant } = {}
+for index, row in LoadRows("RestaurantData") do
+	table.insert(restaurants, {
+		id = if row.id ~= nil then NumberField(row, "id") else index,
+		level = if row.level ~= nil then NumberField(row, "level") else index,
+		name_t = if row.name_t ~= nil then StringField(row, "name_t") else nil,
+		description_t = if row.description_t ~= nil then StringField(row, "description_t") else nil,
+		workers = NumberField(row, "workers"),
+		speed = NumberField(row, "speed"),
+		price = NumberField(row, "price"),
+	})
+end
+assert(#restaurants == 5, "Five restaurant levels are required")
+Config.Restaurants = restaurants
+
+function Config.GetSpecies(id: any): Species?
+	for _, species in Config.Species do
+		if species.id == id or species.key == id or tostring(species.id) == tostring(id) then return species end
+	end
+	return nil
+end
+function Config.GetQuality(id: any): Quality?
+	for _, quality in Config.Qualities do
+		if quality.id == id or quality.key == id or tostring(quality.id) == tostring(id) then return quality end
+	end
+	return nil
+end
+function Config.RollQuality(sample: number): QualityId
+	-- Roblox Random:NextNumber 包含 0 和 1；右端点归入最后的巨型区间。
+	assert(sample >= 0 and sample <= 1, "Quality sample must be in [0, 1]")
+	local cumulative = 0
+	for _, quality in Config.Qualities do
+		cumulative += quality.probability
+		if sample < cumulative then return quality.key end
+	end
+	return "giant"
+end
+function Config.GetDamage(tier: number, level: number): number
+	local weapon = Config.Weapons[tier]
+	assert(weapon and level % 1 == 0 and level >= 1 and level <= Config.MaximumWeaponLevel, "Invalid weapon tier or level")
+	return weapon.damage + weapon.damageIncrement * (level - 1)
+end
+function Config.GetWeaponProgressStep(tier: number, level: number): number
+	return tier * (Config.MaximumWeaponLevel + 1) + level
+end
+
+return Config
diff --git a/Scripts/ReplicatedStorage/Scripts/Shared/FarmHatchRules.luau b/Scripts/ReplicatedStorage/Scripts/Shared/FarmHatchRules.luau
new file mode 100644
index 0000000..998d86f
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Shared/FarmHatchRules.luau
@@ -0,0 +1,21 @@
+-- 孵化原子规则：统一自然到时、免费加速与付费提交，已提交的蛋不能重复生成或扣款
+--!strict
+local Config = if script then require(script.Parent:WaitForChild("FarmEconomyConfig")) else require("./FarmEconomyConfig")
+export type EggState = { landAt: number, finish: number, committed: boolean }
+local Rules = {}
+function Rules.TryCommit(egg: EggState, now: number, instant: boolean?): boolean
+	if egg.committed or now < egg.landAt or (not instant and now < egg.finish) then return false end
+	egg.committed = true
+	return true
+end
+function Rules.Accelerate(egg: EggState, now: number, nextAllowed: number): (boolean, number)
+	if egg.committed or now < egg.landAt or now >= egg.finish or now < nextAllowed then return false, nextAllowed end
+	egg.finish = math.max(now, egg.finish - Config.HatchReductionSeconds)
+	return true, now + Config.HatchCooldownSeconds
+end
+function Rules.TryInstantHatch(egg: EggState, now: number, cash: number, price: number): (boolean, number)
+	if price < 0 or price ~= price or price == math.huge or cash < price or now >= egg.finish then return false, cash end
+	if not Rules.TryCommit(egg, now, true) then return false, cash end
+	return true, cash - price
+end
+return Rules
diff --git a/Scripts/ReplicatedStorage/Scripts/Shared/FarmNumberFormat.luau b/Scripts/ReplicatedStorage/Scripts/Shared/FarmNumberFormat.luau
new file mode 100644
index 0000000..3f3d34e
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Shared/FarmNumberFormat.luau
@@ -0,0 +1,25 @@
+-- 农场数字展示：按一万起缩写与千公斤转吨规则格式化，计算继续使用原值
+--!strict
+local Format = {}
+local Units = { "", "K", "M", "B", "T" }
+local function OneDecimal(value: number): string
+	local rounded = math.floor(value * 10 + 0.5) / 10
+	return if rounded % 1 == 0 then string.format("%.0f", rounded) else string.format("%.1f", rounded)
+end
+function Format.Number(value: number): string
+	assert(value == value and math.abs(value) < math.huge, "Expected finite number")
+	local sign = if value < 0 then "-" else ""
+	local magnitude = math.abs(value)
+	if magnitude < 10000 then return sign .. string.format("%.0f", magnitude) end
+	local unit = 2
+	local scaled = magnitude / 1000
+	while scaled >= 1000 and unit < #Units do scaled /= 1000; unit += 1 end
+	if math.floor(scaled * 10 + 0.5) / 10 >= 1000 and unit < #Units then scaled /= 1000; unit += 1 end
+	return sign .. OneDecimal(scaled) .. Units[unit]
+end
+function Format.Weight(value: number): string
+	assert(value >= 0 and value < math.huge, "Expected nonnegative finite weight")
+	if value < 1000 then return OneDecimal(value) .. " kg" end
+	return OneDecimal(value / 1000) .. " t"
+end
+return Format
diff --git a/Scripts/ReplicatedStorage/Scripts/Shared/FarmRequest.luau b/Scripts/ReplicatedStorage/Scripts/Shared/FarmRequest.luau
new file mode 100644
index 0000000..b78f7e0
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Shared/FarmRequest.luau
@@ -0,0 +1,62 @@
+-- 新版经营请求契约：限制动作和标识长度，隔离客户端输入与服务端权威货物数值
+--!strict
+local Config = if script then require(script.Parent:WaitForChild("FarmEconomyConfig")) else require("./FarmEconomyConfig")
+export type Request = {
+	action: string,
+	targetId: string?,
+	speciesId: string?,
+	tier: number?,
+	confirmationId: string?,
+	aim: { x: number, y: number, z: number }?,
+	expectedStep: number?,
+}
+local FarmRequest = {}
+local SimpleActions = { zap = true, collect = true, buyZap = true, buyCollect = true, buyNest = true, buyRestaurant = true, buyBasket = true, enhanceWeapon = true }
+local SpeciesIds = { chicken = true, rabbit = true, sheep = true, cow = true, dragon = true }
+local function IsId(value: unknown): boolean
+	return type(value) == "string" and #value > 0 and #value <= 128
+end
+function FarmRequest.Parse(value: unknown): Request?
+	if type(value) ~= "table" then return nil end
+	local data = value :: { [string]: unknown }
+	local action = data.action
+	if type(action) ~= "string" then return nil end
+	if SimpleActions[action] then
+		local request: Request = { action = action }
+		if data.expectedStep ~= nil then
+			local step = data.expectedStep
+			if type(step) ~= "number" or step ~= step or step % 1 ~= 0 or step < 1 or step > Config.GetWeaponProgressStep(#Config.Weapons, Config.MaximumWeaponLevel) then return nil end
+			request.expectedStep = step
+		end
+		if action == "zap" and data.aim ~= nil then
+			if type(data.aim) ~= "table" then return nil end
+			local aim = data.aim :: { [string]: unknown }
+			local x, y, z = aim.x, aim.y, aim.z
+			if type(x) ~= "number" or type(y) ~= "number" or type(z) ~= "number" then return nil end
+			local length = math.sqrt(x*x+y*y+z*z)
+			if length ~= length or length < 1e-4 or length == math.huge then return nil end
+			request.aim = { x = x / length, y = y / length, z = z / length }
+		end
+		return request
+	end
+	if action == "accelerateEgg" or action == "requestInstantHatch" then
+		if not IsId(data.targetId) then return nil end
+		local request: Request = { action = action, targetId = data.targetId :: string }
+		return request
+	elseif action == "selectSpecies" then
+		if type(data.speciesId) ~= "string" or not SpeciesIds[data.speciesId] then return nil end
+		local request: Request = { action = action, speciesId = data.speciesId }
+		return request
+	elseif action == "equipWeapon" then
+		local tier = data.tier
+		if type(tier) ~= "number" or tier ~= tier or tier % 1 ~= 0 or tier < 1 or tier > 5 then return nil end
+		local request: Request = { action = action, tier = tier }
+		return request
+	elseif action == "confirm" or action == "cancel" then
+		if not IsId(data.confirmationId) then return nil end
+		local request: Request = { action = action, confirmationId = data.confirmationId :: string }
+		return request
+	end
+	return nil
+end
+return FarmRequest
diff --git a/Scripts/ReplicatedStorage/Scripts/Shared/FarmSaveData.luau b/Scripts/ReplicatedStorage/Scripts/Shared/FarmSaveData.luau
new file mode 100644
index 0000000..fdddfce
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Shared/FarmSaveData.luau
@@ -0,0 +1,197 @@
+-- 经营存档契约：创建独立默认档、验证持久化货物并复制不含实例和绝对时钟的快照
+--!strict
+export type Cargo = {
+	itemId: string,
+	speciesId: string,
+	qualityId: string,
+	weightKg: number,
+	saleValue: number,
+	packSeconds: number,
+	configVersion: number,
+}
+export type Order = {
+	cargo: Cargo,
+	state: "Waiting" | "Processing",
+	remainingSeconds: number,
+	speedSnapshot: number,
+	durationSnapshot: number,
+}
+export type FarmSave = {
+	version: number,
+	revision: number,
+	cash: number,
+	unlockedSpecies: { [string]: boolean },
+	selectedSpeciesId: string,
+	ownedWeapons: { [string]: boolean },
+	weaponLevels: { [string]: number },
+	equippedWeaponTier: number,
+	collectTier: number,
+	basketTier: number,
+	restaurantLevel: number,
+	basket: { Cargo },
+	kitchen: { Order },
+}
+
+local FarmSaveData = {}
+FarmSaveData.Version = 1 -- 独立经营结构版本，与通用玩家档的 dataVersion 分开
+local SpeciesIds = { chicken = true, rabbit = true, sheep = true, cow = true, dragon = true }
+local QualityIds = { normal = true, golden = true, rainbow = true, giant = true }
+
+local function IsFinite(value: unknown): boolean
+	return type(value) == "number" and value == value and math.abs(value) < math.huge
+end
+local function IsInteger(value: unknown, minimum: number, maximum: number): boolean
+	return type(value) == "number" and IsFinite(value) and value % 1 == 0 and value >= minimum and value <= maximum
+end
+local function IsPositive(value: unknown): boolean
+	return type(value) == "number" and IsFinite(value) and value > 0
+end
+local function IsId(value: unknown): boolean
+	return type(value) == "string" and #value > 0 and #value <= 128
+end
+local function ValidateCargo(value: unknown, seen: { [string]: boolean }): boolean
+	if type(value) ~= "table" then return false end
+	local cargo = value :: { [string]: unknown }
+	local id = cargo.itemId
+	if type(id) ~= "string" or not IsId(id) or seen[id] then return false end
+	if type(cargo.speciesId) ~= "string" or not SpeciesIds[cargo.speciesId] then return false end
+	if type(cargo.qualityId) ~= "string" or not QualityIds[cargo.qualityId] then return false end
+	if not IsPositive(cargo.weightKg) or not IsPositive(cargo.packSeconds) then return false end
+	if not IsInteger(cargo.saleValue, 0, 9007199254740991) or not IsInteger(cargo.configVersion, 1, FarmSaveData.Version) then return false end
+	seen[id] = true
+	return true
+end
+local function IsList(value: unknown): boolean
+	if type(value) ~= "table" then return false end
+	local list = value :: { [unknown]: unknown }
+	local count = 0
+	for key in list do
+		if not IsInteger(key, 1, #list) then return false end
+		count += 1
+	end
+	return count == #list
+end
+local function CopyCargo(cargo: Cargo): Cargo
+	return {
+		itemId = cargo.itemId, speciesId = cargo.speciesId, qualityId = cargo.qualityId,
+		weightKg = cargo.weightKg, saleValue = cargo.saleValue, packSeconds = cargo.packSeconds,
+		configVersion = cargo.configVersion,
+	}
+end
+
+function FarmSaveData.CreateDefault(overrideInitialValues: { [string]: any }?): FarmSave
+	local initial = overrideInitialValues or {}
+	local initialUnlocked: { [string]: boolean } = { chicken = true }
+	if initial.UnlockedSpecies then
+		for k, v in initial.UnlockedSpecies do
+			if v == true and SpeciesIds[k] then
+				initialUnlocked[k] = true
+			end
+		end
+	end
+	local initialOwnedWeapons: { [string]: boolean } = { ["1"] = true }
+	if initial.OwnedWeapons then
+		for k, v in initial.OwnedWeapons do
+			if v == true then
+				initialOwnedWeapons[k] = true
+			end
+		end
+	end
+	local initialWeaponLevels: { [string]: number } = { ["1"] = 1 }
+	if initial.WeaponLevels then
+		for k, v in initial.WeaponLevels do
+			if type(v) == "number" and v >= 1 and v <= 5 then
+				initialWeaponLevels[k] = v
+			end
+		end
+	end
+
+	return {
+		version = FarmSaveData.Version,
+		revision = 0, -- 每次原子经营变更递增；用于辨别保存期间的新修改
+		cash = if type(initial.Cash) == "number" and initial.Cash >= 0 then initial.Cash else 0, -- 初始金币
+		unlockedSpecies = initialUnlocked, -- 持久化 Map 全部使用 string key
+		selectedSpeciesId = if type(initial.SelectedSpeciesId) == "string" and initialUnlocked[initial.SelectedSpeciesId] then initial.SelectedSpeciesId else "chicken",
+		ownedWeapons = initialOwnedWeapons,
+		weaponLevels = initialWeaponLevels, -- 每件已购武器独立 Lv.1–5
+		equippedWeaponTier = if type(initial.EquippedWeaponTier) == "number" and initial.EquippedWeaponTier >= 1 and initial.EquippedWeaponTier <= 5 then initial.EquippedWeaponTier else 1,
+		collectTier = if type(initial.CollectTier) == "number" and initial.CollectTier >= 1 and initial.CollectTier <= 5 then initial.CollectTier else 1,
+		basketTier = if type(initial.BasketTier) == "number" and initial.BasketTier >= 1 and initial.BasketTier <= 5 then initial.BasketTier else 1,
+		restaurantLevel = if type(initial.RestaurantLevel) == "number" and initial.RestaurantLevel >= 1 and initial.RestaurantLevel <= 5 then initial.RestaurantLevel else 1,
+		basket = {}, -- 入筐后停止地面过期，保留生成时的重量与售价
+		kitchen = {}, -- FIFO；处理中剩余秒数离线暂停，禁止保存 os.clock 绝对值
+	}
+end
+
+function FarmSaveData.Validate(value: unknown): (boolean, string?)
+	if type(value) ~= "table" then return false, "farm must be a table" end
+	local farm = value :: { [string]: unknown }
+	if farm.version ~= FarmSaveData.Version then return false, "unsupported farm version" end
+	if not IsInteger(farm.revision, 0, 9007199254740991) or not IsInteger(farm.cash, 0, 9007199254740991) then return false, "invalid cash or revision" end
+	for _, field in { "equippedWeaponTier", "collectTier", "basketTier", "restaurantLevel" } do
+		if not IsInteger(farm[field], 1, 5) then return false, "invalid tier: " .. field end
+	end
+	if type(farm.unlockedSpecies) ~= "table" or type(farm.ownedWeapons) ~= "table" or type(farm.weaponLevels) ~= "table" then return false, "invalid progression maps" end
+	local speciesMap = farm.unlockedSpecies :: { [string]: unknown }
+	local weapons = farm.ownedWeapons :: { [string]: unknown }
+	local levels = farm.weaponLevels :: { [string]: unknown }
+	if speciesMap.chicken ~= true or weapons["1"] ~= true then return false, "missing initial equipment" end
+	local previousUnlocked = true
+	for _, id in { "chicken", "rabbit", "sheep", "cow", "dragon" } do
+		if speciesMap[id] == true and not previousUnlocked then return false, "nonsequential species" end
+		previousUnlocked = speciesMap[id] == true
+	end
+	for id, unlocked in speciesMap do
+		if not SpeciesIds[id] or unlocked ~= true then return false, "invalid species unlock" end
+	end
+	if type(farm.selectedSpeciesId) ~= "string" or speciesMap[farm.selectedSpeciesId] ~= true then return false, "selected species is locked" end
+	for key, owned in weapons do
+		local tier = tonumber(key)
+		if not tier or tostring(tier) ~= key or not IsInteger(tier, 1, 5) or owned ~= true or not IsInteger(levels[key], 1, 5) then return false, "invalid owned weapon" end
+		if tier > 1 and weapons[tostring(tier - 1)] ~= true then return false, "nonsequential weapons" end
+	end
+	for key in levels do
+		if weapons[key] ~= true then return false, "level for unowned weapon" end
+	end
+	if weapons[tostring(farm.equippedWeaponTier)] ~= true then return false, "equipped weapon is unowned" end
+	if not IsList(farm.basket) or not IsList(farm.kitchen) then return false, "cargo queues must be lists" end
+	local seen: { [string]: boolean } = {}
+	for _, cargo in farm.basket :: { unknown } do
+		if not ValidateCargo(cargo, seen) then return false, "invalid or duplicate basket cargo" end
+	end
+	for _, valueOrder in farm.kitchen :: { unknown } do
+		if type(valueOrder) ~= "table" then return false, "invalid order" end
+		local order = valueOrder :: { [string]: unknown }
+		if not ValidateCargo(order.cargo, seen) then return false, "invalid or duplicate kitchen cargo" end
+		if not IsFinite(order.remainingSeconds) or not IsFinite(order.durationSnapshot) or not IsFinite(order.speedSnapshot) then return false, "invalid processing timer" end
+		local remaining, duration, speed = order.remainingSeconds :: number, order.durationSnapshot :: number, order.speedSnapshot :: number
+		if order.state == "Waiting" then
+			if remaining ~= 0 or duration ~= 0 or speed ~= 0 then return false, "waiting order has processing snapshot" end
+		elseif order.state == "Processing" then
+			if remaining < 0 or duration <= 0 or remaining > duration or speed <= 0 then return false, "invalid processing snapshot" end
+		else
+			return false, "invalid order state"
+		end
+	end
+	return true, nil
+end
+
+function FarmSaveData.Copy(farm: FarmSave): FarmSave
+	local result = FarmSaveData.CreateDefault()
+	result.version, result.revision, result.cash = farm.version, farm.revision, farm.cash
+	result.unlockedSpecies = table.clone(farm.unlockedSpecies)
+	result.selectedSpeciesId = farm.selectedSpeciesId
+	result.ownedWeapons, result.weaponLevels = table.clone(farm.ownedWeapons), table.clone(farm.weaponLevels)
+	result.equippedWeaponTier, result.collectTier = farm.equippedWeaponTier, farm.collectTier
+	result.basketTier, result.restaurantLevel = farm.basketTier, farm.restaurantLevel
+	for _, cargo in farm.basket do table.insert(result.basket, CopyCargo(cargo)) end
+	for _, order in farm.kitchen do
+		table.insert(result.kitchen, {
+			cargo = CopyCargo(order.cargo), state = order.state, remainingSeconds = order.remainingSeconds,
+			speedSnapshot = order.speedSnapshot, durationSnapshot = order.durationSnapshot,
+		})
+	end
+	return result
+end
+
+return FarmSaveData
diff --git a/Scripts/ReplicatedStorage/Scripts/Shared/FarmSoundTool.luau b/Scripts/ReplicatedStorage/Scripts/Shared/FarmSoundTool.luau
new file mode 100644
index 0000000..cd3df35
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Shared/FarmSoundTool.luau
@@ -0,0 +1,255 @@
+-- 农场声音工具模块：负责管理 ReplicatedStorage.Sounds 模板音效、3D 空间音效对象池回收与 SoundService 背景音乐播放
+--!strict
+local FarmSoundTool = {}
+
+local replicatedStorage: ReplicatedStorage = game:GetService("ReplicatedStorage")
+local soundService: SoundService = game:GetService("SoundService")
+
+local soundsFolder: Folder? = nil
+local localSoundAttachmentsPool: { Attachment } = {}
+local soundsPools: { [Sound]: { Sound } } = {}
+
+local soundGroups: Folder? = soundService:FindFirstChild("SoundGroups") :: Folder?
+local bgmSoundGroup: SoundGroup? = if soundGroups then soundGroups:FindFirstChild("BGM") :: SoundGroup? else nil
+local soundEffectsGroup: SoundGroup? = if soundGroups then soundGroups:FindFirstChild("SoundEffects") :: SoundGroup? else nil
+
+local localSoundsPart: Part? = nil
+
+-- 获取局部声音载体 Part
+local function GetLocalSoundsPart(): Part
+	if localSoundsPart and localSoundsPart.Parent then
+		return localSoundsPart
+	end
+	local part = Instance.new("Part")
+	part.Name = "FarmLocalSoundEffects"
+	part.Transparency = 1
+	part.CanCollide = false
+	part.CanQuery = false
+	part.CanTouch = false
+	part.Anchored = true
+	part.Position = Vector3.zero
+	part.Parent = workspace
+	localSoundsPart = part
+	return part
+end
+
+-- 获取 Sounds 目录引用
+local function GetSoundsFolder(): Folder?
+	if soundsFolder and soundsFolder.Parent then
+		return soundsFolder
+	end
+	local folder = replicatedStorage:FindFirstChild("Sounds")
+	if folder and folder:IsA("Folder") then
+		soundsFolder = folder
+		return folder
+	end
+	return nil
+end
+
+-- 回收局部 Attachment
+local function RestoreAttachment(attachment: Attachment)
+	attachment.Parent = nil
+	table.insert(localSoundAttachmentsPool, attachment)
+end
+
+-- 回收 Sound 实例
+local function RestoreSound(sound: Sound, template: Sound)
+	local parent = sound.Parent
+	if parent and parent:IsA("Attachment") then
+		RestoreAttachment(parent)
+	end
+	sound.Parent = nil
+	local pool = soundsPools[template]
+	if pool then
+		table.insert(pool, sound)
+	else
+		sound:Destroy()
+	end
+end
+
+-- 从对象池获取或实例化 Sound
+local function GetSoundFromPool(soundTemplate: Sound): Sound?
+	local pool = soundsPools[soundTemplate]
+	if pool == nil then
+		local newPool: { Sound } = {}
+		soundsPools[soundTemplate] = newPool
+		soundTemplate.Destroying:Connect(function()
+			local activePool = soundsPools[soundTemplate]
+			if activePool then
+				for _, sound in activePool do
+					sound:Destroy()
+				end
+			end
+			soundsPools[soundTemplate] = nil
+		end)
+		pool = newPool
+	end
+
+	local recycled = table.remove(pool)
+	if recycled then
+		return recycled
+	end
+
+	local cloned: Sound? = soundTemplate:Clone()
+	if not cloned then
+		return nil
+	end
+
+	cloned.Ended:Connect(function()
+		RestoreSound(cloned, soundTemplate)
+	end)
+	cloned.Stopped:Connect(function()
+		RestoreSound(cloned, soundTemplate)
+	end)
+
+	return cloned
+end
+
+-- 获取或复用局部音效挂载的 Attachment
+local function GetLocalSoundAttachment(): Attachment
+	local attachment = table.remove(localSoundAttachmentsPool)
+	if attachment then
+		attachment.Parent = GetLocalSoundsPart()
+		return attachment
+	end
+	local newAttachment = Instance.new("Attachment")
+	newAttachment.Name = "LocalSoundAttachment"
+	newAttachment.Parent = GetLocalSoundsPart()
+	return newAttachment
+end
+
+-- 获取指定音效模板（从 ReplicatedStorage.Sounds）
+function FarmSoundTool.GetSoundTemplate(soundName: string): Sound?
+	local folder = GetSoundsFolder()
+	if not folder then
+		return nil
+	end
+	local child = folder:FindFirstChild(soundName)
+	if child and child:IsA("Sound") then
+		return child
+	end
+	return nil
+end
+
+-- 播放 2D 全局音效模板
+function FarmSoundTool.PlayGlobal(soundTemplate: Sound, looped: boolean?, soundGroup: SoundGroup?): Sound?
+	local sound = GetSoundFromPool(soundTemplate)
+	if not sound then
+		return nil
+	end
+	sound.SoundGroup = soundGroup or soundEffectsGroup
+	sound.Looped = looped == true
+	sound.Parent = soundService
+	sound:Play()
+	return sound
+end
+
+-- 播放 3D 局部空间音效模板
+function FarmSoundTool.PlayLocal(soundTemplate: Sound, soundPosition: Vector3, looped: boolean?, soundGroup: SoundGroup?): Sound?
+	local sound = GetSoundFromPool(soundTemplate)
+	if not sound then
+		return nil
+	end
+	local attachment = GetLocalSoundAttachment()
+	sound.SoundGroup = soundGroup or soundEffectsGroup
+	sound.Looped = looped == true
+	attachment.WorldCFrame = CFrame.new(soundPosition)
+	sound.Parent = attachment
+	sound:Play()
+	return sound
+end
+
+-- 按名称播放音效（统一便捷接口：自动按是否提供坐标切换 2D/3D）
+function FarmSoundTool.Play(soundName: string, soundPosition: Vector3?, volumeMultiplier: number?): Sound?
+	local template = FarmSoundTool.GetSoundTemplate(soundName)
+	if not template then
+		return nil
+	end
+
+	local sound: Sound? = nil
+	if soundPosition then
+		sound = FarmSoundTool.PlayLocal(template, soundPosition, false)
+	else
+		sound = FarmSoundTool.PlayGlobal(template, false)
+	end
+
+	if sound and volumeMultiplier then
+		sound.Volume = template.Volume * volumeMultiplier
+	end
+
+	return sound
+end
+
+-- 播放背景音乐（优先从 SoundService.BGM 获取）
+function FarmSoundTool.PlayBGM(bgmInstanceOrName: (Sound | string)?): Sound?
+	local bgm: Sound? = nil
+	if typeof(bgmInstanceOrName) == "Instance" and bgmInstanceOrName:IsA("Sound") then
+		bgm = bgmInstanceOrName
+	elseif typeof(bgmInstanceOrName) == "string" then
+		local foundInService = soundService:FindFirstChild(bgmInstanceOrName)
+		if foundInService and foundInService:IsA("Sound") then
+			bgm = foundInService
+		else
+			bgm = FarmSoundTool.GetSoundTemplate(bgmInstanceOrName)
+		end
+	else
+		local defaultBGM = soundService:FindFirstChild("BGM")
+		if defaultBGM and defaultBGM:IsA("Sound") then
+			bgm = defaultBGM
+		end
+	end
+
+	if not bgm then
+		return nil
+	end
+
+	if bgmSoundGroup then
+		bgm.SoundGroup = bgmSoundGroup
+	end
+	bgm.Looped = true
+	bgm:Play()
+	return bgm
+end
+
+-- 停止背景音乐
+function FarmSoundTool.StopBGM(bgmInstanceOrName: (Sound | string)?)
+	local bgm: Sound? = nil
+	if typeof(bgmInstanceOrName) == "Instance" and bgmInstanceOrName:IsA("Sound") then
+		bgm = bgmInstanceOrName
+	elseif typeof(bgmInstanceOrName) == "string" then
+		local found = soundService:FindFirstChild(bgmInstanceOrName)
+		if found and found:IsA("Sound") then
+			bgm = found
+		end
+	else
+		local defaultBGM = soundService:FindFirstChild("BGM")
+		if defaultBGM and defaultBGM:IsA("Sound") then
+			bgm = defaultBGM
+		end
+	end
+
+	if bgm then
+		bgm:Stop()
+	end
+end
+
+-- 设置背景音乐音量
+function FarmSoundTool.SetBGMVolume(volume: number)
+	if bgmSoundGroup then
+		bgmSoundGroup.Volume = volume
+	else
+		local defaultBGM = soundService:FindFirstChild("BGM")
+		if defaultBGM and defaultBGM:IsA("Sound") then
+			defaultBGM.Volume = volume
+		end
+	end
+end
+
+-- 设置音效音量
+function FarmSoundTool.SetSoundEffectVolume(volume: number)
+	if soundEffectsGroup then
+		soundEffectsGroup.Volume = volume
+	end
+end
+
+return FarmSoundTool
