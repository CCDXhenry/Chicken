+                "slug": best.get("slug"),
+                "license": best.get("license", "CC0"),
+                "durationMs": best.get("duration_ms"),
+                "downloadUrl": download_url,
+                "description": desc
+            })
+        except Exception as e:
+            print(f"  [ERROR] 下载 {download_url} 失败: {e}", file=sys.stderr)
+
