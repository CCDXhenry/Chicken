+-- 村落客户端回归：检查重生保留的本地标牌，以及流送式后代移除和重新到达的监听恢复
+--!strict
+assert(game:GetService("RunService"):IsClient(), "Play client only")
+local Players = game:GetService("Players")
+local Class = require(game.ReplicatedStorage.Scripts.Client.ClientFarmSpeciesManager)
+local player = Players.LocalPlayer
+local manager = Class.new()
+manager:Scan()
+local map = manager.map
+assert(map and #manager.entries == 3, "Owned farm entries required")
+local shop, sign = map:FindFirstChild("Shop"), map:FindFirstChild("OwnerSign")
+assert(shop and sign)
+local function CountSigns(): number
+	local count = 0
+	for _, gui in player.PlayerGui:GetChildren() do
+		if gui:IsA("BillboardGui") and gui.Adornee == sign then
+			assert(not gui.ResetOnSpawn)
+			count += 1
+		end
+	end
+	return count
+end
+local success, failure = xpcall(function(): boolean
+	assert(CountSigns() == 1, "Owner sign must survive respawn; run after a server-triggered respawn")
+	shop.Parent = nil
+	task.wait(0.1) -- 引擎使用 Deferred 信号；断言在事件队列派发后执行。
+	assert(#manager.entries == 2)
+	shop.Parent = map
+	task.wait(0.1)
+	assert(#manager.entries == 3)
+	sign.Parent = nil
+	task.wait(0.1)
+	assert(CountSigns() == 0, "Stale adornee must be released")
+	sign.Parent = map
+	task.wait(0.1)
+	assert(CountSigns() == 1, "Returning sign must mount exactly once")
+	return true
+end, debug.traceback)
+shop.Parent, sign.Parent = map, map
+manager:Destroy()
+assert(success, failure)
+return { entriesRestored = true, signsRestored = true, note = "Client-only removal/rearrival fixture; does not force engine stream-out" }
diff --git a/Tools/Tests/FarmVillageRuntimeRegression.luau b/Tools/Tests/FarmVillageRuntimeRegression.luau
new file mode 100644
index 0000000..be852b9
--- /dev/null
+++ b/Tools/Tests/FarmVillageRuntimeRegression.luau
@@ -0,0 +1,78 @@
+-- 八人常驻村落运行回归：仅在双人 Play 服务端验证归属、参观、旋转、重生与回收
+--!strict
+local RunService = game:GetService("RunService")
+assert(RunService:IsRunning() and RunService:IsServer(), "Play server only")
+local Players = game:GetService("Players")
+local Manager = require(game.ServerStorage.Scripts.ServerPersonalFarmManager)
+local active = Manager.GetActive()
+assert(active, "Active personal farm manager required")
+local list = Players:GetPlayers()
+assert(#list >= 2, "Two loaded players required")
+local first, second = active.sessions[list[1]], active.sessions[list[2]]
+assert(first and second and first.plot ~= second.plot, "Two independent sessions required")
+local checks: { string } = {}
+local saved: { [Player]: { pivot: CFrame, anchored: boolean } } = {}
+local function Check(value: boolean, message: string): ()
+ assert(value, message); table.insert(checks,message)
+end
+local function Root(player: Player): BasePart
+ local character=player.Character
+ assert(character)
+ local root=character:FindFirstChild("HumanoidRootPart")
+ assert(root and root:IsA("BasePart"))
+ return root
+end
+for _,player in list do
+ local character=player.Character
+ assert(character)
+ saved[player]={pivot=character:GetPivot(),anchored=Root(player).Anchored}
+ Root(player).Anchored=true
+end
+local success,failure=xpcall(function(): boolean
+ Check(#workspace.PersonalFarms:GetChildren()==8 and #workspace.FarmPlots:GetChildren()==8,"Eight static farms and eight anchors")
+ Check(first.map:GetAttribute("OwnerUserId")==first.owner.UserId and second.map:GetAttribute("OwnerUserId")==second.owner.UserId,"Unique live ownership on opposite road sides")
+ Check(first.plot.CFrame.RightVector:Dot(second.plot.CFrame.RightVector)<-0.99,"Opposite farm orientation")
+ for _,session in {first,second} do
+  local spawn=session.map:FindFirstChild("FarmSpawn") :: BasePart
+  local localSpawn=session.plot.CFrame:PointToObjectSpace(spawn.Position)
+  Check((localSpawn-Vector3.new(0,0.45,16)).Magnitude<0.01,"Rotated local spawn anchor: "..session.plot.Name)
+  session.owner:SetAttribute("FarmPlotId",session.plot.Name)
+ end
+ -- 不修改存档，仅把携带货物的玩家置于邻居交货区；业务只读取其自家 Sell。
+ local sell=second.map:FindFirstChild("Sell") :: BasePart
+ local basketCount,cash=#first.farm.basket,first.farm.cash
+ Root(first.owner).CFrame=sell.CFrame*CFrame.new(0,3,0)
+ local unload=first.nextUnloadAt
+ active:Update(os.clock(),0)
+ Check(#first.farm.basket==basketCount and first.farm.cash==cash and first.nextUnloadAt==nil,"Visiting neighbor cannot unload into foreign restaurant")
+ first.nextUnloadAt=unload
+ local egg=second.eggs[1]
+ if egg then
+  local finish=egg.finish
+  active:OnCommand(first.owner,{action="accelerateEgg",targetId=egg.id})
+  Check(egg.finish==finish,"Foreign egg ID rejected by live manager")
+ end
+ -- 回收后原地块建筑引用必须保留，其他会话不被清理。
+ local player,map,plot=first.owner,first.map,first.plot
+ local neighborMap=second.map
+ active:RemovePlayer(player)
+ Check(map.Parent==workspace.PersonalFarms and map:GetAttribute("OwnerUserId")==nil,"Release preserves static farm and clears owner")
+ Check(not map:FindFirstChild("Eggs") and not map:FindFirstChild("LiveAnimals") and not map:FindFirstChild("CookedFood"),"Release removes all production and ground entities")
+ local restaurant,sign=map:FindFirstChild("Restaurant"),map:FindFirstChild("OwnerSign")
+ Check(restaurant~=nil and not restaurant:FindFirstChild("Workers") and sign~=nil and sign:GetAttribute("FarmText")==plot.Name.." · Vacant farm","Vacancy restores public sign and removes workers")
+ Check(active.sessions[second.owner]==second and neighborMap:GetAttribute("OwnerUserId")==second.owner.UserId,"Neighbor session survives release")
+ active:OnPlayerLoaded(player)
+ local restored=active.sessions[player]
+ Check(restored~=nil and restored.map==map and restored.plot==plot,"Lowest released plot reclaimed without cloning buildings")
+ active:OnPlayerLoaded(player)
+ Check(active.sessions[player]==restored and #workspace.PersonalFarms:GetChildren()==8,"Duplicate loaded callback cannot create another farm")
+ return true
+end,debug.traceback)
+for player,record in saved do
+ local character=player.Character
+ if character then character:PivotTo(record.pivot); Root(player).Anchored=record.anchored end
+ local session=active.sessions[player]
+ if session then player:SetAttribute("FarmPlotId",session.plot.Name) end
+end
+assert(success,failure)
+return checks
diff --git a/Tools/Tests/FarmVillageStaticAudit.luau b/Tools/Tests/FarmVillageStaticAudit.luau
new file mode 100644
index 0000000..7798567
--- /dev/null
+++ b/Tools/Tests/FarmVillageStaticAudit.luau
@@ -0,0 +1,72 @@
+-- 八人农场 Edit 静态审计：检查地块、朝向、资产预算、入口通行与标牌模板
+--!strict
+assert(not game:GetService("RunService"):IsRunning(), "Edit audit only")
+local plots = workspace:FindFirstChild("FarmPlots")
+local farms = workspace:FindFirstChild("PersonalFarms")
+local village = workspace:FindFirstChild("FarmVillage")
+assert(plots and farms and village)
+assert(#plots:GetChildren()==8 and #farms:GetChildren()==8)
+local function Count(root: Instance): (number, number)
+ local count,collisions=0,0
+ for _,object in root:GetDescendants() do if object:IsA("BasePart") then count+=1; if object.CanCollide then collisions+=1 end end end
+ return count,collisions
+end
+local function Bounds(part: BasePart, space: CFrame): (Vector3,Vector3)
+ local lo,hi=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
+ for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
+  local point=space:PointToObjectSpace(part.CFrame:PointToWorldSpace(part.Size*Vector3.new(x,y,z)/2))
+  lo,hi=lo:Min(point),hi:Max(point)
+ end end end
+ return lo,hi
+end
+local boxes: { { minimum: Vector3, maximum: Vector3 } }={}
+local rows={-192,-64,64,192}
+local farmParts,farmCollisions=0,0
+for index=1,8 do
+ local name=string.format("Plot%02d",index)
+ local plot,map=plots:FindFirstChild(name),farms:FindFirstChild(name)
+ assert(plot and plot:IsA("BasePart") and map and map:IsA("Folder"),name)
+ assert(map:GetAttribute("FarmId")==name and map:GetAttribute("OwnerUserId")==nil and map:GetAttribute("Occupied")==false)
+ local left=index%2==1
+ assert((plot.Position-Vector3.new(if left then -80 else 80,0,rows[math.ceil(index/2)])).Magnitude<0.001)
+ assert(plot.CFrame.LookVector:Dot(if left then -Vector3.xAxis else Vector3.xAxis)>0.999)
+ for _,key in {"FarmSpawn","Sell","OwnerSign","Nest","Restaurant","Shop"} do assert(map:FindFirstChild(key),name.."/"..key) end
+ local spawn=map:FindFirstChild("FarmSpawn")
+ assert(spawn and spawn:IsA("SpawnLocation") and not spawn.Enabled)
+ for _,key in {"Eggs","LiveAnimals","CookedFood"} do assert(not map:FindFirstChild(key)) end
+ local restaurant=map:FindFirstChild("Restaurant")
+ assert(restaurant and not restaurant:FindFirstChild("Workers"))
+ local minimum,maximum=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
+ for _,part in map:GetDescendants() do if part:IsA("BasePart") then
+  local lo,hi=Bounds(part,plot.CFrame)
+  assert(lo.X>=-56.01 and hi.X<=56.01 and lo.Z>=-50.01 and hi.Z<=62.01,"Part exceeds template footprint: "..part:GetFullName())
+  assert(not part.CanTouch and part:GetAttribute("OwnerUserId")==nil)
+  if part.CanCollide and lo.X<3 and hi.X>-3 and lo.Z<68 and hi.Z>52 and hi.Y>0.5 and lo.Y<5 then error("Farm entry blocked: "..part:GetFullName()) end
+  local worldLo,worldHi=Bounds(part,CFrame.identity)
+  minimum,maximum=minimum:Min(worldLo),maximum:Max(worldHi)
+ end end
+ table.insert(boxes,{minimum=minimum,maximum=maximum})
+ local count,collisions=Count(map)
+ assert(count<=601 and collisions<=159)
+ farmParts+=count; farmCollisions+=collisions
+ local path=village:FindFirstChild("EntryPath_"..name)
+ assert(path and path:IsA("BasePart"))
+ local lo,hi=Bounds(path,plot.CFrame)
+ assert(lo.Z<=52.01 and hi.Z>=67.99 and path.CanCollide)
+end
+for i=1,#boxes do for j=i+1,#boxes do
+ local a,b=boxes[i],boxes[j]
+ assert(a.maximum.X<=b.minimum.X or b.maximum.X<=a.minimum.X or a.maximum.Z<=b.minimum.Z or b.maximum.Z<=a.minimum.Z,"Farm overlap")
+end end
+local road=village:FindFirstChild("CentralRoad")
+assert(road and road:IsA("BasePart") and road.Size.X==24 and road.Size.Z==520)
+assert(workspace.StreamingEnabled)
+local gui=game.ReplicatedStorage.UI:FindFirstChild("FarmOwnerSignGui")
+assert(gui and gui:IsA("BillboardGui") and not gui.ResetOnSpawn and gui.AlwaysOnTop and gui.LightInfluence==0)
+for _,object in gui:GetDescendants() do
+ if object:IsA("TextLabel") then assert(object.TextScaled) end
+ if object:IsA("UIStroke") then assert(object.StrokeSizingMode==Enum.StrokeSizingMode.ScaledSize) end
+end
+local templateParts,templateCollisions=Count(game.ServerStorage.Models.PersonalFarmTemplate)
+local publicParts,publicCollisions=Count(village)
+return {plots=8,templateParts=templateParts,templateCollisions=templateCollisions,farmParts=farmParts,farmCollisions=farmCollisions,publicParts=publicParts,publicCollisions=publicCollisions,farmsInstances=#farms:GetDescendants(),publicInstances=#village:GetDescendants(),maxPlayers=game.Players.MaxPlayers,entryCorridorsClear=true,noOverlaps=true}
diff --git a/Tools/Tests/PersonalFarmRegression.luau b/Tools/Tests/PersonalFarmRegression.luau
new file mode 100644
index 0000000..af20e2a
--- /dev/null
+++ b/Tools/Tests/PersonalFarmRegression.luau
@@ -0,0 +1,259 @@
+-- 个人农场场景回归：仅在获授权的双人 Play 服务端执行，使用独立经营档与远端临时地块
+--!strict
+local RunService = game:GetService("RunService")
+assert(RunService:IsRunning() and RunService:IsServer(), "Run in an authorized Play server")
+local Players = game:GetService("Players")
+local ServerStorage = game:GetService("ServerStorage")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared = ReplicatedStorage:WaitForChild("Scripts"):WaitForChild("Shared")
+local Save = require(Shared:WaitForChild("FarmSaveData"))
+local Config = require(Shared:WaitForChild("FarmEconomyConfig"))
+local Business = require(Shared:WaitForChild("FarmBusiness"))
+local Lifecycle = require(Shared:WaitForChild("LifecycleTool"))
+local GameInfo = require(ServerStorage:WaitForChild("Scripts"):WaitForChild("ServerGameInfo"))
+local Manager = require(ServerStorage:WaitForChild("Scripts"):WaitForChild("ServerPersonalFarmManager"))
+local playerList = Players:GetPlayers()
+assert(#playerList >= 2, "Two loaded players are required")
+local manager = Manager.new()
+manager.running = true
+local scopes: { Lifecycle.Lifecycle } = {}
+local fixtureMaps: { Folder } = {}
+local originalPivots: { [Model]: CFrame } = {}
+local originalAnchored: { [BasePart]: boolean } = {}
+local checks: { string } = {}
+local function CreateFixture(player: Player, x: number, yaw: number): Manager.Session
+	assert(GameInfo.GetPlayerInfo(player), "Wait for real profile loading to finish")
+	local map = ServerStorage.Models.PersonalFarmTemplate:Clone()
+	map.Name = "PersonalFarmRegression_" .. tostring(player.UserId)
+	local scope = Lifecycle.new()
+	table.insert(scopes, scope)
+	local plot = Instance.new("Part")
+	plot.Name, plot.CFrame = map.Name, CFrame.new(x, 0, 10000) * CFrame.Angles(0, math.rad(yaw), 0)
+	scope:Own(plot)
+	for _, object in map:GetDescendants() do
+		if object:IsA("BasePart") then object.CFrame = plot.CFrame * object.CFrame end
+	end
+	map:SetAttribute("FarmId", plot.Name)
+	map:SetAttribute("OwnerUserId", player.UserId)
+	map.Parent = workspace
+	table.insert(fixtureMaps, map)
+	local session: Manager.Session = { owner = player, plot = plot, map = map, scope = scope, farm = Save.CreateDefault(), eggs = {}, animals = {}, ground = {}, nextEggAt = 0, cooldowns = {}, frozen = false, rng = Random.new(17) }
+	manager.sessions[player], manager.reservations[plot] = session, player
+	local character = player.Character
+	assert(character, "Player character required")
+	local root = character:FindFirstChild("HumanoidRootPart")
+	assert(root and root:IsA("BasePart"), "HumanoidRootPart required")
+	originalPivots[character], originalAnchored[root] = character:GetPivot(), root.Anchored
+	root.Anchored = true
+	return session
+end
+local function CountPopulation(session: Manager.Session): number
+	local count = #session.eggs
+	for _ in session.animals do count += 1 end
+	return count
+end
+local function SelectedSpecies(session: Manager.Session): string
+	return session.farm.selectedSpeciesId
+end
+local function Root(player: Player): BasePart
+	local character = player.Character
+	assert(character)
+	local root = character:FindFirstChild("HumanoidRootPart")
+	assert(root and root:IsA("BasePart"))
+	return root
+end
+local function Drop(session: Manager.Session, id: string, species: string, quality: string, position: Vector3): ()
+	local model = Instance.new("Model")
+	model.Name, model.Parent = id, session.map
+	session.ground[id] = { model = model, pos = position, cargo = Business.CreateCargo(id, species, quality), expiresAt = os.clock() + 75 }
+end
+local function ForceHatch(session: Manager.Session, species: string, quality: string, position: Vector3): string
+	session.nextEggAt = 0
+	local now = os.clock()
+	manager:Update(now, 0)
+	local egg = session.eggs[#session.eggs]
+	assert(egg)
+	egg.speciesId, egg.qualityId, egg.landing = species, quality, position
+	egg.landAt, egg.finish = now - 1, now
+	manager:Update(now + 0.001, 0)
+	return egg.id
+end
+local success, failure = xpcall(function(): boolean
+	local first = CreateFixture(playerList[1], 10000, 90)
+	local second = CreateFixture(playerList[2], 10128, -90)
+	manager:Update(0, 0)
+	assert(#first.eggs == 1 and #second.eggs == 1 and first.eggs[1].id ~= second.eggs[1].id)
+	assert(first.eggs[1].model:GetAttribute("OwnerUserId") == first.owner.UserId)
+	assert(second.eggs[1].model:GetAttribute("OwnerUserId") == second.owner.UserId)
+	table.insert(checks, "Independent production and entity ownership")
+	for i = 1, 35 do manager:Update(i * Config.Species[1].interval, 0) end
+	assert(CountPopulation(first) == 28 and CountPopulation(second) == 28)
+	table.insert(checks, "Independent 28 entity caps")
+	for _, session in { first, second } do
+		local _, candidate = next(session.animals)
+		assert(candidate)
+		candidate.pos = session.plot.CFrame:PointToWorldSpace(Vector3.new(-100, 0, 100))
+	end
+	manager:Update(100, 0)
+	for _, session in { first, second } do
+		for _, candidate in session.animals do
+			local point = session.plot.CFrame:PointToObjectSpace(candidate.pos)
+			assert(point.X >= -23.001 and point.X <= 23.001 and point.Z >= -23.001 and point.Z <= 18.001)
+		end
+	end
+	table.insert(checks, "Animals remain inside each rotated local pasture")
+	local _, foreignAnimal = next(second.animals)
+	assert(foreignAnimal)
+	local root1, root2 = Root(first.owner), Root(second.owner)
+	root1.CFrame = CFrame.lookAt(foreignAnimal.pos + Vector3.new(0, 2, 4), foreignAnimal.pos + Vector3.yAxis * 2)
+	manager:OnAction(first.owner, "zap")
+	assert(CountPopulation(second) == 28 and next(second.ground) == nil)
+	first.cooldowns.zap = 0
+	local animal = nil
+	for _, candidate in first.animals do if candidate.qualityId == "normal" then animal = candidate; break end end
+	assert(animal)
+	animal.pos = first.plot.CFrame:PointToWorldSpace(Vector3.new(-20, 0, -20))
+	animal.model:PivotTo(CFrame.new(animal.pos + Vector3.yAxis * 0.78))
+	root1.CFrame = CFrame.lookAt(animal.pos + Vector3.new(0, 2, 4), animal.pos + Vector3.yAxis * 2)
+	manager:OnAction(first.owner, "zap")
+	local id, ground = next(first.ground)
+	assert(id and ground and ground.cargo.saleValue == 10 and ground.cargo.weightKg == 1)
+	root2.CFrame = CFrame.new(ground.pos + Vector3.yAxis * 2)
+	manager:OnAction(second.owner, "collect")
+	assert(#second.farm.basket == 0 and first.ground[id] ~= nil)
+	manager:OnAction(first.owner, "collect")
+	assert(#first.farm.basket == 1 and first.farm.basket[1].itemId == id and first.ground[id] == nil)
+	table.insert(checks, "Foreign combat and pickup rejected; owned cargo keeps identity")
+	local sell = first.map:FindFirstChild("Sell")
+	assert(sell and sell:IsA("BasePart"))
+	root1.CFrame = sell.CFrame + Vector3.yAxis * 2
+	manager:Update(200, 0)
+	assert(#first.farm.basket == 1 and #first.farm.kitchen == 0)
+	manager:Update(200 + Config.UnloadIntervalSeconds - 0.001, 0)
+	assert(#first.farm.basket == 1)
+	manager:Update(200 + Config.UnloadIntervalSeconds + 0.001, 0)
+	assert(#first.farm.basket == 0 and #first.farm.kitchen == 1 and first.farm.kitchen[1].cargo.itemId == id)
+	manager:Update(202, Config.Species[1].packSeconds)
+	assert(first.farm.cash == 10 and second.farm.cash == 0 and #first.farm.kitchen == 0)
+	manager:Update(204, Config.Species[1].packSeconds)
+	assert(first.farm.cash == 10)
+	table.insert(checks, "First unload waits 0.15 seconds; first sale 10; repeated settlement rejected")
+	local secondAnimal = nil
+	for _, candidate in second.animals do if candidate.qualityId == "normal" then secondAnimal = candidate; break end end
+	assert(secondAnimal)
+	secondAnimal.pos = second.plot.CFrame:PointToWorldSpace(Vector3.new(-20, 0, -20))
+	secondAnimal.model:PivotTo(CFrame.new(secondAnimal.pos + Vector3.yAxis * 0.78))
+	root2.CFrame = CFrame.lookAt(secondAnimal.pos + Vector3.new(0, 2, 4), secondAnimal.pos + Vector3.yAxis * 2)
+	second.cooldowns.zap, second.cooldowns.collect = 0, 0
+	manager:OnAction(second.owner, "zap")
+	manager:OnAction(second.owner, "collect")
+	assert(#second.farm.basket == 1)
+	local secondSell = second.map:FindFirstChild("Sell")
+	assert(secondSell and secondSell:IsA("BasePart"))
+	root2.CFrame = secondSell.CFrame + Vector3.yAxis * 2
+	manager:Update(205, 0)
+	manager:Update(205 + Config.UnloadIntervalSeconds + 0.001, 0)
+	manager:Update(207, Config.Species[1].packSeconds)
+	assert(second.farm.cash == 10 and first.farm.cash == 10 and #second.farm.kitchen == 0)
+	table.insert(checks, "Opposite rotated farms both finish kill, pickup, delivery and independent sale")
+
+	-- 后续阶段继续使用同一隔离夹具；不改真实 profile.farm，不直接调用存档服务。
+	first.farm.cash = 300
+	Business.TryCollect(first.farm, Business.CreateCargo("keep-basket", "chicken", "normal"))
+	Drop(first, "keep-ground", "chicken", "normal", first.plot.Position + Vector3.new(0, 0, 50))
+	local beforeCount = CountPopulation(first)
+	manager:OnCommand(first.owner, { action = "selectSpecies", speciesId = "rabbit" })
+	local prompt = first.confirmation
+	assert(prompt and first.farm.cash == 300 and SelectedSpecies(first) == "chicken")
+	manager:OnCommand(first.owner, { action = "cancel", confirmationId = prompt.id })
+	assert(CountPopulation(first) == beforeCount and first.farm.cash == 300)
+	first.cooldowns.selectSpecies = 0
+	manager:OnCommand(first.owner, { action = "selectSpecies", speciesId = "rabbit" })
+	prompt = first.confirmation
+	assert(prompt)
+	manager:OnCommand(first.owner, { action = "confirm", confirmationId = "wrong-token" })
+	assert(first.farm.cash == 300)
+	-- 模拟在确认弹窗开启期间后台下蛋循环生成新蛋，确认操作仍需一次生效
+	first.nextEggAt = 0
+	manager:Update(os.clock(), 0)
+	assert(#first.eggs > 0)
+	manager:OnCommand(first.owner, { action = "confirm", confirmationId = prompt.id })
+	assert(CountPopulation(first) == 0 and first.farm.cash == 0 and SelectedSpecies(first) == "rabbit")
+	assert(#first.farm.basket == 1 and first.ground["keep-ground"] ~= nil)
+	manager:OnCommand(first.owner, { action = "confirm", confirmationId = prompt.id })
+	assert(first.farm.cash == 0)
+	first.cooldowns.selectSpecies = 0
+	local switchAt = os.clock()
+	manager:OnCommand(first.owner, { action = "selectSpecies", speciesId = "chicken" })
+	assert(SelectedSpecies(first) == "chicken" and first.farm.cash == 0 and first.nextEggAt >= switchAt + Config.Species[1].interval)
+	table.insert(checks, "Species confirmation cancel/replay safety; clear preserves ground and basket; free T1 recovery waits full interval")
+	first.cooldowns.selectSpecies = 0
+	manager:OnCommand(first.owner, { action = "selectSpecies", speciesId = "rabbit" })
+	first.nextEggAt = 0
+	manager:Update(os.clock(), 0)
+	local goldenEgg = first.eggs[1]
+	assert(goldenEgg)
+	goldenEgg.speciesId, goldenEgg.qualityId = "rabbit", "golden"
+	goldenEgg.landAt, goldenEgg.finish = os.clock() - 1, os.clock() + 100
+	root1.CFrame = CFrame.new(goldenEgg.landing + Vector3.yAxis * 2)
+	first.farm.cash = 25
+	manager:OnCommand(first.owner, { action = "requestInstantHatch", targetId = goldenEgg.id })
+	prompt = first.confirmation
+	assert(prompt and prompt.kind == "hatch")
+	local oldFinish = goldenEgg.finish
+	manager:OnCommand(first.owner, { action = "accelerateEgg", targetId = goldenEgg.id })
+	local acceleratedFinish = goldenEgg.finish
+	manager:OnCommand(first.owner, { action = "accelerateEgg", targetId = goldenEgg.id })
+	assert(acceleratedFinish == oldFinish - 1 and goldenEgg.finish == acceleratedFinish)
+	manager:OnCommand(second.owner, { action = "requestInstantHatch", targetId = goldenEgg.id })
+	assert(not second.confirmation and second.farm.cash == 10)
