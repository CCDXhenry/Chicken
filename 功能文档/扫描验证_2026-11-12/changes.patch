+-- 个人农场类型契约：共享实体、经营会话、确认令牌与服务端测量状态
+--!strict
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local Shared = ReplicatedStorage:WaitForChild("Scripts"):WaitForChild("Shared")
+local Save = require(Shared:WaitForChild("FarmSaveData"))
+local Lifecycle = require(Shared:WaitForChild("LifecycleTool"))
+
+export type Egg = { id: string, model: Model, speciesId: string, qualityId: string, height: number, origin: Vector3, landing: Vector3, started: number, landAt: number, finish: number, committed: boolean }
+export type Animal = { id: string, model: Model, speciesId: string, qualityId: string, pos: Vector3, center: Vector3, direction: Vector3, nextTurn: number, health: number, maxHealth: number, fleeUntil: number, fleeReadyAt: number }
+export type Confirmation = { id: string, kind: "species" | "hatch", speciesId: string?, previousSpeciesId: string?, targetId: string?, expiresAt: number, entityIds: { [string]: boolean }? }
+export type GroundCargo = { model: Model, pos: Vector3, cargo: Save.Cargo, expiresAt: number }
+export type FarmMetrics = {
+	[string]: number,
+	startedAt: number, cashStart: number, salesIncome: number, spent: number, sold: number,
+	spawned: number, killed: number, collected: number, delivered: number, expired: number,
+	fullSeconds: number, waitingItemSeconds: number, processingItemSeconds: number,
+	unloadSeconds: number, deliveredKg: number, trips: number,
+	firstSaleSeconds: number, firstEnhancementSeconds: number, firstAffordEnhancementSeconds: number,
+	normalEggs: number, goldenEggs: number, rainbowEggs: number, giantEggs: number,
+}
+export type Session = {
+	owner: Player, plot: BasePart, map: Folder, scope: Lifecycle.Lifecycle, farm: Save.FarmSave,
+	eggs: { Egg }, animals: { [string]: Animal }, ground: { [string]: GroundCargo },
+	nextEggAt: number, nextUnloadAt: number?, cooldowns: { [string]: number }, frozen: boolean, rng: Random,
+	confirmation: Confirmation?,
+	metrics: FarmMetrics?,
+	testQualitySequence: { string }?, testQualityIndex: number?,
+	projectedEggId: string?, projectedEggFinish: number?,
+	lastUpdateAt: number?,
+}
+return {}
diff --git a/Scripts/ServerStorage/Scripts/ServerPersonalFarmView.luau b/Scripts/ServerStorage/Scripts/ServerPersonalFarmView.luau
new file mode 100644
index 0000000..ebe31e4
--- /dev/null
+++ b/Scripts/ServerStorage/Scripts/ServerPersonalFarmView.luau
@@ -0,0 +1,252 @@
+-- 个人农场表现层：投影玩家属性、克隆鸡筐和服务员模板并维护品质视觉与主人标牌
+--!strict
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local ServerStorage = game:GetService("ServerStorage")
+local Shared = ReplicatedStorage:WaitForChild("Scripts"):WaitForChild("Shared")
+local Config = require(Shared:WaitForChild("FarmEconomyConfig"))
+local Save = require(Shared:WaitForChild("FarmSaveData"))
+local Business = require(Shared:WaitForChild("FarmBusiness"))
+local Texts = require(Shared:WaitForChild("GameTexts"))
+local NumberFormat = require(Shared:WaitForChild("FarmNumberFormat"))
+local Scene = require(script.Parent:WaitForChild("ServerRoastChickenFarmManager"):WaitForChild("ServerFarmSceneTool"))
+local WeaponBuilder = require(script.Parent:WaitForChild("ServerRoastChickenFarmManager"):WaitForChild("ServerWeaponBuilder"))
+local Types = require(script.Parent:WaitForChild("ServerPersonalFarmTypes"))
+type Session = Types.Session
+type Egg = Types.Egg
+local View = {}
+
+local function ApplySpecies(model: Model, speciesId: string): ()
+	local colors = Config.SpeciesAppearance[speciesId]
+	if not colors then return end
+	for _, part in model:GetDescendants() do
+		if part:IsA("BasePart") and colors[part.Name] then
+			part.Color = Color3.fromHex(colors[part.Name])
+			if speciesId == "dragon" and part.Name == "Spine" then part.Material = Enum.Material.Neon end
+		end
+	end
+end
+
+local function SetOwnership(instance: Instance, session: Session): ()
+	instance:SetAttribute("OwnerUserId", session.owner.UserId)
+	instance:SetAttribute("FarmId", session.plot.Name)
+end
+local function SetSign(part: BasePart, template: string, text: string, ownerId: number, audience: string?): ()
+	part:SetAttribute("OwnerUserId", ownerId)
+	part:SetAttribute("FarmSignAudience", audience or "Public")
+	Scene.BindSign(part, template, nil, audience or "Public")
+	Scene.SetSignText(part, text)
+end
+local function UpdateBasketVisual(session: Session): ()
+	local character = session.owner.Character
+	local root = Scene.GetPlayerRoot(session.owner)
+	if not character or not root then return end
+	local count = #session.farm.basket
+	local basket = character:FindFirstChild("ChickenBasket")
+	if count == 0 then if basket then basket:Destroy() end; return end
+	if not basket then
+		local template = ServerStorage:WaitForChild("Models"):FindFirstChild("FarmBasketTemplate")
+		if not template or not template:IsA("Model") then return end
+		local clone = template:Clone()
+		local basketRoot = clone.PrimaryPart
+		if not basketRoot then clone:Destroy(); return end
+		clone.Name = "ChickenBasket"
+		clone:PivotTo(root.CFrame * CFrame.new(0, -0.45, 1.15))
+		for _, part in clone:GetDescendants() do if part:IsA("BasePart") then part.Anchored = false; part.Massless = true end end
+		local weld = Instance.new("WeldConstraint")
+		weld.Name, weld.Part0, weld.Part1, weld.Parent = "CharacterWeld", root, basketRoot, basketRoot
+		clone.Parent = character
+		basket = clone
+	end
+	if not basket then return end
+	for index = 1, 6 do
+		local roast = basket:FindFirstChild("Roast" .. index)
+		if roast and roast:IsA("BasePart") then roast.Transparency = if index <= count then 0 else 1 end
+	end
+end
+local function UpdateWeaponVisual(session: Session): ()
+	local player, farm = session.owner, session.farm
+	local character = player.Character
+	if not character then return end
+	local humanoid = character:FindFirstChildOfClass("Humanoid")
+	if not humanoid or humanoid.Health <= 0 then return end
+	local tier = farm.equippedWeaponTier
+	local level = farm.weaponLevels[tostring(tier)] or 1
+	local backpack = player:FindFirstChildOfClass("Backpack")
+
+	local existingInChar = character:FindFirstChild("FarmWeapon")
+	local existingInBackpack = if backpack then backpack:FindFirstChild("FarmWeapon") else nil
+	local currentTool = (if existingInChar and existingInChar:IsA("Tool") then existingInChar else (if existingInBackpack and existingInBackpack:IsA("Tool") then existingInBackpack else nil)) :: Tool?
+
+	if currentTool then
+		local currentTier = currentTool:GetAttribute("WeaponTier")
+		local currentLevel = currentTool:GetAttribute("WeaponLevel")
+		if currentTier == tier and currentLevel == level then
+			if currentTool.Parent ~= character then
+				humanoid:EquipTool(currentTool)
+			end
+			return
+		end
+		currentTool:Destroy()
+	end
+
+	for _, item in character:GetChildren() do
+		if item:IsA("Tool") and item.Name == "FarmWeapon" then item:Destroy() end
+	end
+	if backpack then
+		for _, item in backpack:GetChildren() do
+			if item:IsA("Tool") and item.Name == "FarmWeapon" then item:Destroy() end
+		end
+	end
+
+	local tool = WeaponBuilder.BuildWeaponTool(tier, level)
+	if backpack then
+		tool.Parent = backpack
+		humanoid:EquipTool(tool)
+	else
+		tool.Parent = character
+	end
+end
+local function UpdateRestaurantVisuals(session: Session, waiting: number, processing: number, expected: number): ()
+	local player, farm = session.owner, session.farm
+	local restaurant = session.map:FindFirstChild("Restaurant")
+	local stockSign = if restaurant then restaurant:FindFirstChild("StockSign") else nil
+	if stockSign and stockSign:IsA("BasePart") then
+		SetSign(stockSign, "RestaurantSignGui", Texts.Farm.PersonalKitchen.source:format(waiting, processing, NumberFormat.Number(expected)), player.UserId)
+	end
+	if restaurant then
+		local workers: Instance
+		local existingWorkers = restaurant:FindFirstChild("Workers")
+		if existingWorkers then workers = existingWorkers else
+			local folder = Instance.new("Folder")
+			folder.Name, folder.Parent = "Workers", restaurant
+			workers = folder
+		end
+		local head = restaurant:FindFirstChild("QueueHead")
+		local entrance = restaurant:FindFirstChild("QueueStart")
+		local template = ServerStorage:WaitForChild("Models"):FindFirstChild("FarmWorkerTemplate")
+		if head and head:IsA("BasePart") and entrance and entrance:IsA("BasePart") and template and template:IsA("Model") then
+			local orders: { Save.Order } = {}
+			for _, order in farm.kitchen do if order.state == "Processing" then table.insert(orders, order) end end
+			local forward = Scene.FlatVector(head.Position - entrance.Position)
+			if forward.Magnitude < 0.01 then forward = Vector3.zAxis else forward = forward.Unit end
+			local right = Vector3.new(forward.Z, 0, -forward.X)
+			for index = 1, Config.Restaurants[farm.restaurantLevel].workers do
+				local name = "Worker" .. index
+				local model = workers:FindFirstChild(name)
+				local spot = restaurant:FindFirstChild("WorkerSpot" .. index) or restaurant:FindFirstChild("Worker" .. index .. "Spot")
+				local targetCFrame: CFrame
+				if spot and spot:IsA("BasePart") then
+					spot.Transparency = 1
+					targetCFrame = spot.CFrame
+				else
+					local counter = restaurant:FindFirstChild("ServiceCounter" .. index)
+					local counterPos: Vector3
+					if counter and counter:IsA("BasePart") then
+						counterPos = counter.Position
+					else
+						counterPos = head.Position + forward * 4.05 + right * ((index - 1) * 5.1)
+					end
+					local standPosition = Vector3.new(counterPos.X, head.Position.Y + 0.1, counterPos.Z) + forward * 2.0
+					targetCFrame = CFrame.lookAt(standPosition, Vector3.new(counterPos.X, head.Position.Y + 0.1, counterPos.Z))
+				end
+				if not model then
+					local clone = template:Clone()
+					clone.Name = name
+					clone:PivotTo(targetCFrame)
+					SetOwnership(clone, session)
+					clone.Parent = workers
+					model = clone
+				end
+				if model and model:IsA("Model") and model.PrimaryPart then
+					local order = orders[index]
+					model.PrimaryPart:SetAttribute("FarmStudsOffsetY", 3.8)
+					SetSign(model.PrimaryPart, "WorkerSignGui", if order then Texts.Farm.WorkerPacking.source:format(index, math.ceil(order.remainingSeconds)) else Texts.Farm.WorkerIdle.source:format(index), player.UserId)
+				end
+			end
+		end
+	end
+end
+local function Project(session: Session, egg: Egg?, now: number): ()
+	UpdateBasketVisual(session)
+	UpdateWeaponVisual(session)
+	local player, farm = session.owner, session.farm
+	local waiting, processing, expected = Business.GetKitchenCounts(farm)
+	player:SetAttribute("FarmStage", 5)
+	player:SetAttribute("FarmReady", not session.frozen)
+	player:SetAttribute("FarmCash", farm.cash)
+	player:SetAttribute("FarmBasket", #farm.basket)
+	player:SetAttribute("FarmBasketWeight", Business.GetWeight(farm))
+	player:SetAttribute("FarmBasketCapacity", Config.Baskets[farm.basketTier].capacityKg)
+	player:SetAttribute("FarmDamage", Config.GetDamage(farm.equippedWeaponTier, farm.weaponLevels[tostring(farm.equippedWeaponTier)]))
+	player:SetAttribute("FarmZap", farm.equippedWeaponTier)
+	player:SetAttribute("FarmCollect", farm.collectTier)
+	player:SetAttribute("FarmBasketTier", farm.basketTier)
+	player:SetAttribute("FarmWeaponLevel", farm.weaponLevels[tostring(farm.equippedWeaponTier)])
+	for tier = 1, #Config.Weapons do player:SetAttribute("FarmWeaponLevel_" .. tier, farm.weaponLevels[tostring(tier)] or 0) end
+	player:SetAttribute("FarmStock", waiting + processing)
+	player:SetAttribute("FarmWaiting", waiting)
+	player:SetAttribute("FarmProcessing", processing)
+	player:SetAttribute("FarmExpectedValue", expected)
+	local selected = Config.GetSpecies(farm.selectedSpeciesId)
+	player:SetAttribute("FarmNestLevel", if selected then selected.tier else 1)
+	for _, species in Config.Species do player:SetAttribute("FarmSpecies_" .. species.key, farm.unlockedSpecies[species.key] == true) end
+	player:SetAttribute("FarmRestaurantLevel", farm.restaurantLevel)
+	local eggSpecies = if egg then Config.GetSpecies(egg.speciesId) else nil
+	player:SetAttribute("FarmEggSpecies", if eggSpecies then eggSpecies.name else nil)
+	player:SetAttribute("FarmEggQuality", if egg then egg.qualityId else nil)
+	if egg then
+		if session.projectedEggId ~= egg.id or session.projectedEggFinish ~= egg.finish then
+			player:SetAttribute("FarmEggEndTime", workspace:GetServerTimeNow() + math.max(0, egg.finish - now))
+			session.projectedEggId, session.projectedEggFinish = egg.id, egg.finish
+		end
+	else
+		player:SetAttribute("FarmEggEndTime", nil)
+		session.projectedEggId, session.projectedEggFinish = nil, nil
+	end
+	player:SetAttribute("FarmEggPrice", if eggSpecies then eggSpecies.instantHatchPrice else nil)
+	player:SetAttribute("FarmEggId", if egg then egg.id else nil)
+	-- 个人升级统一从 HUD 发请求，关闭旧版共享区域的升级投影。
+	player:SetAttribute("FarmShop", false)
+	player:SetAttribute("FarmNestShop", false)
+	player:SetAttribute("FarmRestaurantShop", false)
+	UpdateRestaurantVisuals(session, waiting, processing, expected)
+end
+local function ApplyQuality(model: Model, qualityId: string): ()
+	local quality = Config.GetQuality(qualityId)
+	assert(quality)
+	if quality.visualScale ~= 1 then model:ScaleTo(model:GetScale() * quality.visualScale) end
+	if qualityId == "normal" then return end
+	local highlight = Instance.new("Highlight")
+	highlight.Name = "QualityGlow"
+	highlight.FillColor = if qualityId == "golden" then Color3.fromRGB(255, 204, 40) else Color3.fromRGB(127, 240, 255)
+	highlight.OutlineColor, highlight.FillTransparency = highlight.FillColor, 0.65
+	highlight.Parent = model
+	if qualityId == "golden" then
+		for _, part in model:GetDescendants() do if part:IsA("BasePart") then part.Color = highlight.FillColor; part.Material = Enum.Material.Metal end end
+	elseif qualityId == "giant" then
+		local bounds, size = model:GetBoundingBox()
+		local aura = Scene.CreatePiece(model, "GiantAura", Vector3.new(0.12, size.X * 1.4, size.Z * 1.4), CFrame.new(bounds.Position - Vector3.yAxis * (size.Y / 2)) * CFrame.Angles(0, 0, math.pi / 2), "8AF3FF")
+		aura.Shape, aura.Material, aura.Transparency = Enum.PartType.Cylinder, Enum.Material.Neon, 0.8
+	end
+end
+local function UpdateQuality(model: Model, qualityId: string, now: number): ()
+	if qualityId == "giant" then
+		local aura = model:FindFirstChild("GiantAura")
+		if aura and aura:IsA("BasePart") then aura.Transparency = 0.75 + math.sin(now * 6) * 0.1 end
+	end
+	if qualityId ~= "rainbow" then return end
+	local highlight = model:FindFirstChild("QualityGlow")
+	if highlight and highlight:IsA("Highlight") then
+		highlight.FillColor = Color3.fromHSV((now * 0.2) % 1, 0.75, 1)
+		highlight.OutlineColor = highlight.FillColor
+	end
+end
+
+View.SetOwnership = SetOwnership
+View.ApplySpecies = ApplySpecies
+View.SetSign = SetSign
+View.ApplyQuality = ApplyQuality
+View.UpdateQuality = UpdateQuality
+View.UpdateWeaponVisual = UpdateWeaponVisual
+View.Project = Project
+return View
diff --git a/Scripts/ServerStorage/Scripts/ServerPlayerSaveStore.luau b/Scripts/ServerStorage/Scripts/ServerPlayerSaveStore.luau
new file mode 100644
index 0000000..dc1a452
--- /dev/null
+++ b/Scripts/ServerStorage/Scripts/ServerPlayerSaveStore.luau
@@ -0,0 +1,106 @@
+-- 玩家存档业务封装：沿用真实 PlayerInfo 数据仓库，以条件更新租约串行保存完整玩家快照
+--!strict
+local ServerStorage = game:GetService("ServerStorage")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local HttpService = game:GetService("HttpService")
+local DataStoreTool = require(ServerStorage:WaitForChild("Core"):WaitForChild("Scripts"):WaitForChild("DataStoreTool"))
+local Shared = ReplicatedStorage:WaitForChild("Scripts"):WaitForChild("Shared")
+local GameConfig = require(Shared:WaitForChild("GameConfig"))
+local FarmSave = require(Shared:WaitForChild("FarmSaveData"))
+local Rules = require(script.Parent:WaitForChild("PlayerSaveLeaseRules"))
+type Record = { token: string, revision: number, expiresAt: number, lastChangeRevision: number, busy: boolean, closing: boolean }
+local Store = {}
+Store.__index = Store
+export type ServerPlayerSaveStore = typeof(setmetatable({} :: { dataStore: GlobalDataStore, records: { [number]: Record } }, Store))
+local LeaseSeconds = 120 -- 自动保存 30 秒；超过 120 秒未成功续租即冻结并退出，避免旧服继续经营
+
+local function GetMetadata(keyInfo: DataStoreKeyInfo?): Rules.Metadata
+	return if keyInfo then keyInfo:GetMetadata() else {}
+end
+local function GetUserIds(keyInfo: DataStoreKeyInfo?, userId: number): { number }
+	if keyInfo then return keyInfo:GetUserIds() end
+	-- Studio 多人模拟使用负数测试 ID，不把它们登记为真实用户关联。
+	return if userId > 0 then { userId } else {}
+end
+function Store.new(dataStore: GlobalDataStore): ServerPlayerSaveStore
+	return setmetatable({ dataStore = dataStore, records = {} }, Store)
+end
+function Store.IsActive(self: ServerPlayerSaveStore, userId: number): boolean
+	local record = self.records[userId]
+	return record ~= nil and not record.closing and record.expiresAt > os.time()
+end
+function Store.IsBusy(self: ServerPlayerSaveStore, userId: number): boolean
+	local record = self.records[userId]
+	return record ~= nil and record.busy
+end
+function Store.Acquire(self: ServerPlayerSaveStore, userId: number): (boolean, unknown, string?)
+	if self.records[userId] then return false, nil, "alreadyLoading" end
+	local record: Record = { token = HttpService:GenerateGUID(false), revision = 0, expiresAt = 0, lastChangeRevision = -1, busy = true, closing = false }
+	self.records[userId] = record
+	local default = GameConfig.CreateDefaultPlayerSaveInfo()
+	local accepted = false
+	local reason: string?
+	local storedMetadata: Rules.Metadata?
+	local function Transform(current: unknown, keyInfo: DataStoreKeyInfo?): (unknown, { number }?, Rules.Metadata?)
+		accepted = false
+		if record.closing then reason = "closedWhileLoading"; return nil end
+		local metadata, errorReason = Rules.Acquire(GetMetadata(keyInfo), record.token, os.time(), LeaseSeconds)
+		if not metadata then reason = errorReason; return nil end
+		accepted, storedMetadata = true, metadata
+		return if current == nil then default else current, GetUserIds(keyInfo, userId), metadata
+	end
+	local success, value = DataStoreTool.SafeUpdate(self.dataStore, tostring(userId), Transform)
+	record.busy = false
+	if success and accepted and storedMetadata then
+		record.revision = Rules.GetRevision(storedMetadata) or 0
+		record.expiresAt = storedMetadata.ChickenSessionExpires :: number
+		return true, value, nil
+	end
+	return false, nil, if success then reason or "acquireRejected" else "storageFailure"
+end
+function Store.Save(self: ServerPlayerSaveStore, userId: number, snapshot: GameConfig.PlayerSaveInfo, changeRevision: number): (boolean, string?)
+	local record = self.records[userId]
+	if not record then return false, "leaseLost" end
+	while record.busy do task.wait() end
+	if record.closing then return false, "leaseLost" end
+	if changeRevision < record.lastChangeRevision then return true, "superseded" end
+	local valid, invalidReason = FarmSave.Validate(snapshot.farm)
+	if not valid then return false, invalidReason end
+	record.busy = true
+	local expectedRevision, operationId = record.revision, HttpService:GenerateGUID(false)
+	local accepted, replayed = false, false
+	local reason: string?
+	local storedMetadata: Rules.Metadata?
+	local function Transform(current: unknown, keyInfo: DataStoreKeyInfo?): (unknown, { number }?, Rules.Metadata?)
+		accepted = false
+		local metadata, replay, errorReason = Rules.Write(GetMetadata(keyInfo), record.token, os.time(), LeaseSeconds, expectedRevision, operationId)
+		if not metadata then reason = errorReason; return nil end
+		accepted, replayed, storedMetadata = true, replay, metadata
+		return if replayed then current else snapshot, GetUserIds(keyInfo, userId), metadata
+	end
+	local success = DataStoreTool.SafeUpdate(self.dataStore, tostring(userId), Transform)
+	record.busy = false
+	if success and accepted and storedMetadata then
+		record.revision = Rules.GetRevision(storedMetadata) or record.revision
+		record.expiresAt = storedMetadata.ChickenSessionExpires :: number
+		record.lastChangeRevision = math.max(record.lastChangeRevision, changeRevision)
+		return true, nil
+	end
+	if reason == "leaseLost" or reason == "staleRevision" or reason == "invalidMetadata" then record.expiresAt = 0 end
+	return false, if success then reason or "writeRejected" else "storageFailure"
+end
+function Store.Release(self: ServerPlayerSaveStore, userId: number): boolean
+	local record = self.records[userId]
+	if not record then return true end
+	record.closing = true
+	while record.busy do task.wait() end
+	local function Transform(current: unknown, keyInfo: DataStoreKeyInfo?): (unknown, { number }?, Rules.Metadata?)
+		local metadata = Rules.Release(GetMetadata(keyInfo), record.token)
+		if not metadata then return nil end
+		return current, GetUserIds(keyInfo, userId), metadata
+	end
+	local success = DataStoreTool.SafeUpdate(self.dataStore, tostring(userId), Transform)
+	self.records[userId] = nil
+	return success
+end
+return Store
