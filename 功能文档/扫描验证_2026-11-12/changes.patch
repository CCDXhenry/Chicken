+-- 已拥有装备独立窗口：展示各阶武器的等级并切换当前武器
+--!strict
+local Storage = game:GetService("ReplicatedStorage")
+local Config = require(Storage.Scripts.Shared.FarmEconomyConfig)
+local Info = require(script.Parent.Parent.ClientGameInfo)
+local Common = require(script.Parent.Common)
+local Equipment = {}
+function Equipment.Bind(ctx: Common.Context): ()
+	local list = ctx.panel:WaitForChild("ItemsScrollingFrame")
+	local function Render(): ()
+		local info = Info.GetFarmInfo()
+		local levels = info.weaponLevels or { ["1"] = 1 }
+		Common.Wallet(ctx)
+		for tier = 1, #Config.Weapons do
+			local level = levels[tostring(tier)] or 0
+			local card = list:WaitForChild("Item" .. tier .. "Frame")
+			Common.Label(card, "NameText", "Tier " .. tier .. " weapon")
+			Common.Label(card, "DetailText", if level > 0 then "Lv." .. level .. "  /  " .. Config.GetDamage(tier, level) .. " damage" else "Available at the tool shed")
+			Common.State(Common.Button(card, "ActionButton"), if ctx.pending then "Working…" elseif level == 0 then "Not owned" elseif tier == info.zap then "Equipped" else "Equip", not ctx.pending and level > 0 and tier ~= info.zap)
+		end
+	end
+	for tier = 1, #Config.Weapons do
+		local button = Common.Button(list:WaitForChild("Item" .. tier .. "Frame"), "ActionButton")
+		local function OnEquip(): () if button.Active then Common.Submit(ctx, { action = "equipWeapon", tier = tier }, Render) end end
+		ctx.window.scope:Connect(button.Activated:Connect(OnEquip))
+	end
+	Common.Observe(ctx, Render)
+end
+return Equipment
diff --git a/Scripts/ReplicatedStorage/Scripts/Client/FarmWindows/Hatch.luau b/Scripts/ReplicatedStorage/Scripts/Client/FarmWindows/Hatch.luau
new file mode 100644
index 0000000..10c3fd9
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Client/FarmWindows/Hatch.luau
@@ -0,0 +1,42 @@
+-- 孵化独立窗口：绑定倒计时、免费长按加速与立即孵化确认
+--!strict
+local Storage = game:GetService("ReplicatedStorage")
+local Input = game:GetService("UserInputService")
+local Info = require(script.Parent.Parent.ClientGameInfo)
+local Common = require(script.Parent.Common)
+local Controller = require(script.Parent.Parent.ClientHatchController)
+local Hatch = {}
+function Hatch.Bind(ctx: Common.Context): ()
+	local stop = Controller.Stop
+	local eggId = Info.GetFarmInfo().eggId
+	local instant = Common.Button(ctx.panel, "InstantButton")
+	local accelerate = Common.Button(ctx.panel, "AccelerateButton")
+	local activeInput: InputObject? = nil
+	local duration = math.max(1, (Info.GetFarmInfo().eggEndTime or 0) - workspace:GetServerTimeNow())
+	local function Render(): ()
+		local info = Info.GetFarmInfo()
+		if info.eggId ~= eggId then stop(); ctx.window:Close(); return end
+		local seconds = math.max(0, (info.eggEndTime or 0) - workspace:GetServerTimeNow())
+		Common.Wallet(ctx)
+		Common.Label(ctx.panel, "InfoText", (info.eggSpecies or "Egg") .. "  /  " .. (info.eggQuality or "normal"))
+		Common.Label(ctx.panel, "TimeText", string.format("%.1f seconds", seconds))
+		local fill = ctx.panel:WaitForChild("ProgressFrame"):WaitForChild("FillFrame") :: Frame
+		fill.Size = UDim2.fromScale(math.clamp(1 - seconds / duration, 0, 1), 1)
+		Common.State(instant, if ctx.pending then "Working…" else "Hatch now  /  " .. Common.Price(info.eggPrice), not ctx.pending and info.cash >= (info.eggPrice or 0))
+	end
+	local function OnBegan(input: InputObject): ()
+		if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and Controller.Start("Window", eggId, input) then activeInput = input end
+	end
+	local function OnEnded(input: InputObject): ()
+		if input == activeInput or (activeInput and input.UserInputType == Enum.UserInputType.MouseButton1) then activeInput = nil; stop() end
+	end
+	local function OnInstant(): () stop(); if instant.Active and eggId then Common.Submit(ctx, { action = "requestInstantHatch", targetId = eggId }, Render) end end
+	ctx.window.scope:Connect(accelerate.InputBegan:Connect(OnBegan))
+	ctx.window.scope:Connect(Input.InputEnded:Connect(OnEnded))
+	ctx.window.scope:Connect(instant.Activated:Connect(OnInstant))
+	local oldClose = ctx.window.onClosed
+	ctx.window.onClosed = function(): () stop(); if oldClose then oldClose() end end
+	Common.Observe(ctx, Render)
+	ctx.window.scope:Spawn(function(): () while ctx.window.scope.alive do task.wait(0.1); if ctx.window.scope.alive then Render() end end end)
+end
+return Hatch
diff --git a/Scripts/ReplicatedStorage/Scripts/Client/FarmWindows/Purchase.luau b/Scripts/ReplicatedStorage/Scripts/Client/FarmWindows/Purchase.luau
new file mode 100644
index 0000000..6ef4b83
--- /dev/null
+++ b/Scripts/ReplicatedStorage/Scripts/Client/FarmWindows/Purchase.luau
@@ -0,0 +1,68 @@
+-- 独立购买窗口绑定器：展示当前与下一档能力并发送带进度校验的升级请求
+--!strict
+local Storage = game:GetService("ReplicatedStorage")
+local Config = require(Storage.Scripts.Shared.FarmEconomyConfig)
+local Info = require(script.Parent.Parent.ClientGameInfo)
+local Common = require(script.Parent.Common)
+local Purchase = {}
+function Purchase.Bind(ctx: Common.Context, action: string): ()
+	local details = ctx.panel:WaitForChild("DetailsFrame")
+	local button = Common.Button(details, "PurchaseButton")
+	local price: number? = nil
+	local step = 1
+	local function Render(): ()
+		local info = Info.GetFarmInfo()
+		local current, nextValue, extra, name = "", "", "", ""
+		price = nil
+		if action == "buyZap" then
+			local levels = info.weaponLevels or { ["1"] = 1 }
+			local nextTier: number? = nil
+			for tier = 2, #Config.Weapons do if (levels[tostring(tier)] or 0) == 0 then nextTier = tier; break end end
+			step = (nextTier or (#Config.Weapons + 1)) - 1
+			name = if nextTier then "Tier " .. nextTier .. " weapon" else "All weapons owned"
+			current = "Equipped damage  " .. tostring(info.damage or 2)
+			if nextTier then local w = Config.Weapons[nextTier]; price = w.price; nextValue = "New damage  " .. Config.GetDamage(nextTier, 1); extra = tostring(w.range) .. " range  /  " .. w.maximumTargets .. " targets" end
+			for tier = 1, #Config.Weapons do Common.Label(ctx.panel:WaitForChild("Tier" .. tier .. "Frame"), "StateText", "T" .. tier .. if (levels[tostring(tier)] or 0) > 0 then " Owned" else " Locked") end
+		elseif action == "enhanceWeapon" then
+			for tier = 1, #Config.Weapons do (ctx.panel:WaitForChild("WeaponPreview" .. tier) :: ViewportFrame).Visible = tier == info.zap end
+			local level = info.weaponLevel or 1
+			step = Config.GetWeaponProgressStep(info.zap, level)
+			price = Config.Weapons[info.zap].enhancementPrices[level]
+			name = "Tier " .. info.zap .. "  /  Level " .. level
+			current = "Current damage  " .. Config.GetDamage(info.zap, level)
+			nextValue = if price then "Next damage  " .. Config.GetDamage(info.zap, level + 1) else "Your weapon is fully enhanced"
+			extra = "Enhancement stays with this weapon"
+		elseif action == "buyCollect" then
+			step = info.collect
+			local a, b = Config.Collectors[step], Config.Collectors[step + 1]
+			name = "Tier " .. step .. " collector"
+			current = a.range .. " range  /  " .. a.maximumItems .. " items"
+			if b then price = b.price; nextValue = b.range .. " range  /  " .. b.maximumItems .. " items" else nextValue = "Your collector is fully upgraded" end
+			extra = "Collect more with every trip"
+		elseif action == "buyBasket" then
+			step = info.basketTier or 1
+			local a, b = Config.Baskets[step], Config.Baskets[step + 1]
+			name = "Tier " .. step .. " basket"
+			current = "Current capacity  " .. a.capacityKg .. " kg"
+			if b then price = b.price; nextValue = "Next capacity  " .. b.capacityKg .. " kg" else nextValue = "Your basket is fully upgraded" end
+			extra = "In your basket  " .. tostring(info.basketWeight or 0) .. " kg"
+		else
+			step = info.restaurantLevel
+			local a, b = Config.Restaurants[step], Config.Restaurants[step + 1]
+			name = "Restaurant level " .. step
+			current = a.workers .. " workers  /  " .. a.speed .. "x speed"
+			if b then price = b.price; nextValue = b.workers .. " workers  /  " .. b.speed .. "x speed" else nextValue = "Your restaurant is fully upgraded" end
+			extra = (info.waiting or 0) .. " waiting / " .. (info.processing or 0) .. " cooking / " .. (info.expectedValue or 0) .. " coins"
+		end
+		Common.Wallet(ctx)
+		Common.Label(details, "ItemNameText", name)
+		Common.Label(details, "CurrentText", current)
+		Common.Label(details, "NextText", nextValue)
+		Common.Label(details, "ExtraText", extra)
+		Common.State(button, if ctx.pending then "Working…" elseif price and info.cash < price then "Need " .. Common.Price(price - info.cash) else Common.Price(price), not ctx.pending and price ~= nil and info.cash >= (price or math.huge))
+	end
+	local function OnPurchase(): () if button.Active then Common.Submit(ctx, { action = action, expectedStep = step }, Render) end end
+	ctx.window.scope:Connect(button.Activated:Connect(OnPurchase))
+	Common.Observe(ctx, Render)
+end
+return Purchase
