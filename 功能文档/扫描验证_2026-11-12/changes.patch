@@ -0,0 +1,142 @@
+"""
+OBS Media CLI Tool
+为开发者与 Agent 提供针对 Roblox Studio 视口的快捷多媒体命令行工具。
+用法:
+  python Tools/Studio/obs_media_tool.py screenshot [--save PATH] [--source NAME] [--width W]
+  python Tools/Studio/obs_media_tool.py record start
+  python Tools/Studio/obs_media_tool.py record stop
+  python Tools/Studio/obs_media_tool.py record status
+  python Tools/Studio/obs_media_tool.py record chapter <chapter_name>
+  python Tools/Studio/obs_media_tool.py check
+"""
+
+import argparse
+import os
+import sys
+import json
+
+from obs_controller import OBSController, DEFAULT_SOURCE_NAME
+
+
+def handle_screenshot(args, controller: OBSController):
+    save_path = args.save
+    if not save_path:
+        default_dir = os.path.join("Assets", "Studio")
+        os.makedirs(default_dir, exist_ok=True)
+        save_path = os.path.join(default_dir, f"capture_{int(os.times().system * 1000)}.png")
+
+    source = args.source or DEFAULT_SOURCE_NAME
+    width = args.width if args.width > 0 else None
+
+    print(f"[CLI] 正在对源【{source}】执行截屏...")
+    res = controller.take_screenshot(
+        source_name=source,
+        save_path=save_path,
+        image_format=args.format,
+        image_width=width,
+        quality=args.quality
+    )
+    if res.get("success"):
+        print(f"[CLI] 截屏成功！文件已保存至: {res.get('save_path')}")
+        file_size = os.path.getsize(res.get('save_path'))
+        print(f"[CLI] 图像尺寸/大小: {file_size / 1024:.1f} KB")
+    else:
+        print(f"[CLI] 截屏失败: {res}")
+
+
+def handle_record(args, controller: OBSController):
+    action = args.action.lower()
+    if action == "start":
+        controller.ensure_roblox_window_attached()
+        controller.start_record()
+        print(f"[CLI] 已发送开始录制指令。当前状态: 录制中")
+        status = controller.get_record_status()
+        print(f"[CLI] 录制状态: Active={status.get('outputActive')}, Timecode={status.get('outputTimecode')}")
+
+    elif action == "stop":
+        video_path = controller.stop_record()
+        if video_path:
+            print(f"[CLI] 已停止录制！视频输出路径: {video_path}")
+            if os.path.exists(video_path):
+                size_mb = os.path.getsize(video_path) / (1024 * 1024)
+                print(f"[CLI] 文件大小: {size_mb:.2f} MB")
+        else:
+            print(f"[CLI] 当前未处于录制状态或未获取到输出路径。")
+
+    elif action == "status":
+        status = controller.get_record_status()
+        print("[CLI] OBS 录制状态:")
+        print(f"  - 正在录制: {status.get('outputActive')}")
+        print(f"  - 已暂停:   {status.get('outputPaused')}")
+        print(f"  - 录制时间: {status.get('outputTimecode')}")
+        print(f"  - 写入字节: {status.get('outputBytes', 0) / 1024 / 1024:.2f} MB")
+
+    elif action == "pause":
+        paused = controller.toggle_record_pause()
+        print(f"[CLI] 录像已{'暂停' if paused else '恢复'}。")
+
+    elif action == "chapter":
+        cname = args.name or "Mark"
+        controller.create_record_chapter(cname)
+        print(f"[CLI] 已在录像中标记章节: 【{cname}】")
+    else:
+        print(f"[CLI] 未知录像指令: {action}")
+
+
+def handle_check(args, controller: OBSController):
+    connected = controller.is_connected()
+    print("================ OBS 服务状态体检 ================")
+    print(f"1. WebSocket (127.0.0.1:4455): {'[在线]' if connected else '[离线]'}")
+    if not connected:
+        print("   -> 请确认 OBS 已启动，并已在【工具 -> obs-websocket 设置】中开启 WebSocket 服务（端口 4455）。")
+        return
+
+    info = controller.get_obs_info()
+    print(f"2. OBS Studio 版本:           v{info.get('obsVersion')}")
+    print(f"3. obs-websocket 协议版本:    v{info.get('obsWebSocketVersion')}")
+    print(f"4. 默认录像目录:              {controller.get_record_directory()}")
+
+    attached = controller.ensure_roblox_window_attached()
+    active_win = controller.find_active_roblox_window()
+    print(f"5. Roblox Studio 活跃窗口:    {active_win or '未检测到活跃窗口'}")
+    print(f"6. 窗口源自动绑定状态:        {'已成功绑定最新窗口' if attached else '保持默认/需开启 Studio'}")
+    print("==================================================")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="OBS Media CLI for Roblox Studio")
+    subparsers = parser.add_subparsers(dest="command", help="子命令")
+
+    # 截屏命令
+    p_shot = subparsers.add_parser("screenshot", help="截取 Roblox Studio 视口画面")
+    p_shot.add_argument("--save", type=str, help="图片保存路径")
+    p_shot.add_argument("--source", type=str, default=DEFAULT_SOURCE_NAME, help="OBS 捕获来源名称")
+    p_shot.add_argument("--width", type=int, default=0, help="目标图像宽度")
+    p_shot.add_argument("--format", type=str, default="png", choices=["png", "jpg", "webp"], help="图像格式")
+    p_shot.add_argument("--quality", type=int, default=-1, help="图像压缩质量 (1-100)")
+
+    # 录制命令
+    p_rec = subparsers.add_parser("record", help="控制 OBS 录制生命周期")
+    p_rec.add_argument("action", choices=["start", "stop", "status", "pause", "chapter"], help="录制动作")
+    p_rec.add_argument("--name", type=str, default="", help="章节标记名称")
+
+    # 体检命令
+    subparsers.add_parser("check", help="检查 OBS 连通性与 Studio 窗口捕获状态")
+
+    args = parser.parse_args()
+    if not args.command:
+        parser.print_help()
+        sys.exit(0)
+
+    controller = OBSController()
+
+    if args.command == "check":
+        handle_check(args, controller)
+    elif args.command == "screenshot":
+        handle_screenshot(args, controller)
+    elif args.command == "record":
+        handle_record(args, controller)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/Tools/Studio/obs_studio_bridge.py b/Tools/Studio/obs_studio_bridge.py
new file mode 100644
index 0000000..6d1a57a
--- /dev/null
+++ b/Tools/Studio/obs_studio_bridge.py
@@ -0,0 +1,182 @@
+"""
+Roblox Studio & OBS Media Bridge
+统一多媒体桥接层，将 OBS 录像/截屏能力与 Roblox MCP 自动化测试深度融合。
+支持自动化测试录制上下文管理器 (RobloxRecordSession) 与多源截屏优雅降级机制。
+"""
+
+import os
+import sys
+import time
+import logging
+from typing import Optional, Dict, Any
+
+from obs_controller import OBSController, DEFAULT_SOURCE_NAME
+
+logger = logging.getLogger("RobloxMediaBridge")
+
+
+class RobloxRecordSession:
+    """
+    自动化实机测试录像上下文管理器。
+    使用示例:
+    ```python
+        with RobloxRecordSession("Chicken_Farm_Regression_Test") as session:
+            # 1. 启动 Play 模式
+            # 2. 模拟角色动作或烤鸡操作
+            session.snapshot("Assets/Studio/regression_step1.png")
+            # 3. 校验断言
+        # 退出上下文后自动完成 MP4 视频落盘与归档
+    ```
+    """
+
+    def __init__(
+        self,
+        session_name: str = "RobloxTestSession",
+        max_duration_sec: int = 300,
+        obs_controller: Optional[OBSController] = None
+    ):
+        self.session_name = session_name
+        self.max_duration_sec = max_duration_sec
+        self.obs = obs_controller or OBSController()
+        self.video_output_path: Optional[str] = None
+        self.is_recording = False
+        self.start_timestamp = 0.0
+
+    def __enter__(self):
+        if not self.obs.is_connected():
+            print(f"[RecordSession] 警告: 未检测到 OBS WebSocket，跳过录像。")
+            return self
+
+        try:
+            self.obs.ensure_roblox_window_attached()
+            self.obs.start_record()
+            self.is_recording = True
+            self.start_timestamp = time.time()
+            # 插入首个标记点
+            self.obs.create_record_chapter(f"Start_{self.session_name}")
+            print(f"[RecordSession] 已开启 OBS 视频录制: 【{self.session_name}】")
+        except Exception as e:
+            print(f"[RecordSession] 启动录制失败: {e}")
+
+        return self
+
+    def snapshot(self, save_path: str, chapter_mark: Optional[str] = None) -> Optional[str]:
+        """在录制过程中抓取高清快照并可打入章节标记"""
+        if chapter_mark and self.is_recording:
+            self.obs.create_record_chapter(chapter_mark)
+
+        if self.obs.is_connected():
+            res = self.obs.take_screenshot(save_path=save_path)
+            return res.get("save_path")
+        return None
+
+    def mark_chapter(self, chapter_name: str):
+        """插入章节标记，方便后续在播放器中按章节跳转"""
+        if self.is_recording:
+            self.obs.create_record_chapter(chapter_name)
+
+    def __exit__(self, exc_type, exc_val, exc_tb):
+        if not self.is_recording:
+            return False
+
+        try:
+            # 等待 0.5s 确保尾帧写入
+            time.sleep(0.5)
+            self.video_output_path = self.obs.stop_record()
+            duration = time.time() - self.start_timestamp
+            self.is_recording = False
+
+            if exc_type is not None:
+                print(f"[RecordSession] 测试过程中出现异常 [{exc_type.__name__}: {exc_val}]！")
+                print(f"[RecordSession] 故障录像已完好留存用于排查分析: {self.video_output_path} (录制时长: {duration:.1f}s)")
+            else:
+                print(f"[RecordSession] 录像正常结束，视频文件已落地: {self.video_output_path} (时长: {duration:.1f}s)")
+        except Exception as e:
+            print(f"[RecordSession] 停止录像时发生异常: {e}")
+
+        return False  # 不吞没原有的业务异常
+
+
+class RobloxMediaBridge:
+    """
+    Roblox Studio 多媒体统一门面：
+    支持 OBS 高保真截屏/录像与 Roblox 原生 MCP screen_capture 自由切换与自动降级。
+    """
+
+    def __init__(self, mcp_client=None, obs_controller: Optional[OBSController] = None):
+        self.mcp_client = mcp_client
+        self.obs = obs_controller or OBSController()
+
+    def capture_screenshot(
+        self,
+        save_path: Optional[str] = None,
+        prefer_obs: bool = True,
+        camera_position=None,
+        look_at_position=None,
+        studio_id: Optional[str] = None
+    ) -> Dict[str, Any]:
+        """
+        截取 Studio 画面。
+        :param save_path: 保存文件路径
+        :param prefer_obs: 优先使用 OBS 窗口截屏；若 OBS 不在线或指定了自定义镜头坐标，降级使用原生 MCP
+        :param camera_position: 原生 MCP 的临时镜头坐标 [x, y, z]
+        :param look_at_position: 原生 MCP 的临时注视目标 [x, y, z]
+        """
+        # 如果指定了特定镜头角度，使用原生 MCP 的镜头位移截屏
+        if camera_position is not None or look_at_position is not None or not prefer_obs:
+            return self._capture_native_mcp(save_path, camera_position, look_at_position, studio_id)
+
+        # 尝试 OBS 截屏
+        if self.obs.is_connected():
+            try:
+                res = self.obs.take_screenshot(save_path=save_path)
+                res["provider"] = "OBS"
+                return res
+            except Exception as e:
+                logger.warning(f"OBS 截屏失败，尝试降级原生 MCP: {e}")
+
+        # 降级到原生 MCP
+        return self._capture_native_mcp(save_path, camera_position, look_at_position, studio_id)
+
+    def _capture_native_mcp(self, save_path, camera_position, look_at_position, studio_id):
+        if not self.mcp_client:
+            raise RuntimeError("未配置有效的 RobloxMCPClient，无法调用原生截屏。")
+
+        args: Dict[str, Any] = {
+            "capture_id": f"Capture_{int(time.time())}"
+        }
+        if camera_position:
+            args["camera_position"] = camera_position
+        if look_at_position:
+            args["look_at_position"] = look_at_position
+        if studio_id:
+            args["studio_id"] = studio_id
+
+        res = self.mcp_client.call_tool("screen_capture", args)
+        return {
+            "success": True,
+            "provider": "RobloxMCP",
+            "raw_result": res,
+            "save_path": save_path
+        }
+
+    def start_recording(self) -> bool:
+        """开始视频录制"""
+        return self.obs.start_record()
+
+    def stop_recording(self) -> str:
+        """停止视频录制并返回绝对路径"""
+        return self.obs.stop_record()
+
+    def record_session(self, session_name: str, max_duration_sec: int = 300) -> RobloxRecordSession:
+        """创建录制上下文管理器"""
+        return RobloxRecordSession(session_name, max_duration_sec, self.obs)
+
+
+if __name__ == "__main__":
+    bridge = RobloxMediaBridge()
+    print(f"[MediaBridge] OBS 可用状态: {bridge.obs.is_connected()}")
+    if bridge.obs.is_connected():
+        print(f"[MediaBridge] 正在抓取 OBS 测试截图...")
+        snap_res = bridge.capture_screenshot(save_path="Assets/Studio/obs_test_preview.png")
+        print(f"[MediaBridge] 截屏结果: {snap_res}")
