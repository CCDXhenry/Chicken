.tmp/
.codex-tmp/
Temp/
scratch/
sourcemap.json
*.tmp
*.temp
*.log
~$*
.DS_Store
Thumbs.db
/Assets/Studio/*test*.png
/Assets/Studio/capture_*.png
Roblox-chicken

# Restore/build output inside the converter source tree.
# SVN-managed converter runtime is excluded above with its external root.
/Tools/**/bin/
/Tools/**/obj/
/Tools/**/packages/
*.suo
*.user
*.userosscache
*.sln.docstates
