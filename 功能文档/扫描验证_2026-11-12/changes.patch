+            fallback_q = query.split()[-1]
+            print(f"  未命中，尝试回退关键词: '{fallback_q}'")
+            items = search_sfxmint(fallback_q, limit=5)
+
+        if not items:
+            print(f"  [FAIL] 未找到匹配音效: {name}")
+            continue
